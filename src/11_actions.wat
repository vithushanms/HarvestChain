;; Player actions (spec §5-§9) and the act dispatcher. Every action validates first and
;; mutates only on success; a non-zero return leaves state bytes unchanged.
;; act(id, a, b, c): ids per shared-context Actions table. Ids 10-18 are wired by later tasks.
;; act never consumes RNG here.

(global $E_BAD_ARG       i32 (i32.const 1))
(global $E_STATUS        i32 (i32.const 2))
(global $E_TILE_OUT      i32 (i32.const 3))
(global $E_TILE_BUSY     i32 (i32.const 4))
(global $E_SEASON        i32 (i32.const 5))
(global $E_CASH          i32 (i32.const 6))
(global $E_LOCKED        i32 (i32.const 7))
(global $E_NOT_RIPE      i32 (i32.const 8))
(global $E_STORAGE_FULL  i32 (i32.const 9))
(global $E_NO_STOCK      i32 (i32.const 10))
(global $E_MAX           i32 (i32.const 14))
(global $E_NOT_BUILDING  i32 (i32.const 19))

(global $BLD_GREENHOUSE  i32 (i32.const 7))
(global $BLD_GARAGE      i32 (i32.const 9))
(global $CROP_APPLE      i32 (i32.const 3))
(global $EV_BUMPER       i32 (i32.const 6))
(global $ST_RESULTS      i32 (i32.const 1))
(global $ST_ENDLESS      i32 (i32.const 2))

;; Crop growing on the tile at ptr: crop id for a crop tile or a Greenhouse with ghCrop, else -1.
(func $tile_crop (param $p i32) (result i32)
  (if (i32.eq (i32.load8_u (local.get $p)) (i32.const 1))
    (then (return (i32.load8_u offset=1 (local.get $p)))))
  (if (i32.and (i32.eq (i32.load8_u (local.get $p)) (i32.const 2))
               (i32.eq (i32.load8_u offset=1 (local.get $p)) (global.get $BLD_GREENHOUSE)))
    (then (if (i32.load8_u offset=6 (local.get $p))
      (then (return (i32.sub (i32.load8_u offset=6 (local.get $p)) (i32.const 1)))))))
  (i32.const -1))

;; 1 when the tile holds a crop whose progress has reached its target.
;; target = growDays*100, or regrowDays*100 for an Apple with appleMature set.
(func $tile_ripe (param $p i32) (result i32)
  (local $c i32) (local $col i32)
  (local.set $c (call $tile_crop (local.get $p)))
  (if (i32.lt_s (local.get $c) (i32.const 0)) (then (return (i32.const 0))))
  (local.set $col (i32.const 1))
  (if (i32.and (i32.eq (local.get $c) (global.get $CROP_APPLE))
               (i32.and (i32.load8_u offset=5 (local.get $p)) (i32.const 1)))
    (then (local.set $col (i32.const 3))))
  (i32.ge_u (i32.load16_u offset=2 (local.get $p))
            (i32.mul (call $bal (global.get $T_CROP) (local.get $c) (local.get $col)) (i32.const 100))))

(func $clear_cellar (param $idx i32)
  (memory.fill (i32.add (global.get $S_CELLAR) (i32.mul (local.get $idx) (i32.const 5)))
               (i32.const 0) (i32.const 5)))

(func $clear_tile (param $idx i32)
  (memory.fill (call $tile_ptr (local.get $idx)) (i32.const 0) (global.get $TILE_STRIDE)))

;; Harvest one tile. Returns 0, E_BAD_ARG (nothing growing), E_NOT_RIPE or E_STORAGE_FULL.
(func $harvest_tile (param $idx i32) (result i32)
  (local $p i32) (local $c i32) (local $u i32)
  (local.set $p (call $tile_ptr (local.get $idx)))
  (local.set $c (call $tile_crop (local.get $p)))
  (if (i32.lt_s (local.get $c) (i32.const 0)) (then (return (global.get $E_BAD_ARG))))
  (if (i32.eqz (call $tile_ripe (local.get $p))) (then (return (global.get $E_NOT_RIPE))))
  (local.set $u (call $bal (global.get $T_CROP) (local.get $c) (i32.const 2)))
  (if (call $event_active (global.get $EV_BUMPER))
    (then (local.set $u (i32.div_u (i32.mul (local.get $u) (call $k (global.get $K_BUMPER_BP))) (i32.const 10000)))))
  (if (i32.gt_u (local.get $u) (i32.sub (call $storage_cap) (call $storage_used)))
    (then (return (global.get $E_STORAGE_FULL))))
  (call $inv_add (local.get $c) (local.get $u))
  (if (i32.eq (i32.load8_u (local.get $p)) (i32.const 1))
    (then
      (if (i32.eq (local.get $c) (global.get $CROP_APPLE))
        (then
          (i32.store8 offset=5 (local.get $p) (i32.or (i32.load8_u offset=5 (local.get $p)) (i32.const 1)))
          (i32.store16 offset=2 (local.get $p) (i32.const 0))
          (i32.store8 offset=4 (local.get $p) (i32.const 0)))
        (else (call $clear_tile (local.get $idx)))))
    (else
      ;; Greenhouse: an Apple keeps its ghCrop and becomes mature, anything else is emptied.
      (i32.store16 offset=2 (local.get $p) (i32.const 0))
      (i32.store8 offset=4 (local.get $p) (i32.const 0))
      (if (i32.eq (local.get $c) (global.get $CROP_APPLE))
        (then (i32.store8 offset=5 (local.get $p) (i32.or (i32.load8_u offset=5 (local.get $p)) (i32.const 1))))
        (else (i32.store8 offset=6 (local.get $p) (i32.const 0))))))
  (i32.const 0))

(func $a_plant (param $idx i32) (param $crop i32) (result i32)
  (local $p i32) (local $cost i32)
  (if (i32.eqz (call $in_grid (local.get $idx))) (then (return (global.get $E_TILE_OUT))))
  (if (i32.gt_u (local.get $crop) (i32.const 4)) (then (return (global.get $E_BAD_ARG))))
  (local.set $p (call $tile_ptr (local.get $idx)))
  (local.set $cost (call $bal (global.get $T_CROP) (local.get $crop) (i32.const 0)))
  (if (i32.eqz (i32.load8_u (local.get $p)))
    (then
      (if (i32.eqz (i32.and (call $bal (global.get $T_CROP) (local.get $crop) (i32.const 5))
                            (i32.shl (i32.const 1) (call $season))))
        (then (return (global.get $E_SEASON))))
      (if (i32.lt_s (i32.load (global.get $S_CASH)) (local.get $cost)) (then (return (global.get $E_CASH))))
      (i32.store (global.get $S_CASH) (i32.sub (i32.load (global.get $S_CASH)) (local.get $cost)))
      (i64.store (local.get $p) (i64.const 0))
      (i32.store8 (local.get $p) (i32.const 1))
      (i32.store8 offset=1 (local.get $p) (local.get $crop))
      (return (i32.const 0))))
  (if (i32.and (i32.eq (i32.load8_u (local.get $p)) (i32.const 2))
               (i32.and (i32.eq (i32.load8_u offset=1 (local.get $p)) (global.get $BLD_GREENHOUSE))
                        (i32.eqz (i32.load8_u offset=6 (local.get $p)))))
    (then
      (if (i32.lt_s (i32.load (global.get $S_CASH)) (local.get $cost)) (then (return (global.get $E_CASH))))
      (i32.store (global.get $S_CASH) (i32.sub (i32.load (global.get $S_CASH)) (local.get $cost)))
      (i32.store8 offset=6 (local.get $p) (i32.add (local.get $crop) (i32.const 1)))
      (i32.store16 offset=2 (local.get $p) (i32.const 0))
      (i32.store8 offset=4 (local.get $p) (i32.const 0))
      (return (i32.const 0))))
  (global.get $E_TILE_BUSY))

(func $a_harvest (param $idx i32) (result i32)
  (if (i32.eqz (call $in_grid (local.get $idx))) (then (return (global.get $E_TILE_OUT))))
  (call $harvest_tile (local.get $idx)))

(func $a_harvest_all (result i32)
  (local $i i32)
  (loop $l
    (if (call $in_grid (local.get $i))
      (then (drop (call $harvest_tile (local.get $i)))))
    (br_if $l (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (i32.const 64))))
  (i32.const 0))

;; Building unlock predicate from T_BLD unlockKind/unlockArg.
(func $bld_unlocked (param $bld i32) (result i32)
  (local $kind i32) (local $arg i32)
  (local.set $kind (call $bal (global.get $T_BLD) (local.get $bld) (i32.const 4)))
  (local.set $arg (call $bal (global.get $T_BLD) (local.get $bld) (i32.const 5)))
  (if (i32.eq (local.get $kind) (i32.const 1)) (then (return (i32.gt_u (call $count_bld (local.get $arg)) (i32.const 0)))))
  (if (i32.eq (local.get $kind) (i32.const 2)) (then (return (i32.ge_u (call $rank) (local.get $arg)))))
  (if (i32.eq (local.get $kind) (i32.const 3)) (then (return (i32.ge_u (i32.load16_u (global.get $S_DAY)) (local.get $arg)))))
  (i32.eqz (local.get $kind)))

(func $a_build (param $idx i32) (param $bld i32) (result i32)
  (local $p i32) (local $cost i32)
  (if (i32.eqz (call $in_grid (local.get $idx))) (then (return (global.get $E_TILE_OUT))))
  (if (i32.gt_u (local.get $bld) (i32.const 9)) (then (return (global.get $E_BAD_ARG))))
  (local.set $p (call $tile_ptr (local.get $idx)))
  (if (i32.load8_u (local.get $p)) (then (return (global.get $E_TILE_BUSY))))
  (if (i32.eqz (call $bld_unlocked (local.get $bld))) (then (return (global.get $E_LOCKED))))
  (local.set $cost (call $bal (global.get $T_BLD) (local.get $bld) (i32.const 0)))
  (if (i32.lt_s (i32.load (global.get $S_CASH)) (local.get $cost)) (then (return (global.get $E_CASH))))
  (i32.store (global.get $S_CASH) (i32.sub (i32.load (global.get $S_CASH)) (local.get $cost)))
  (i64.store (local.get $p) (i64.const 0))
  (i32.store8 (local.get $p) (i32.const 2))
  (i32.store8 offset=1 (local.get $p) (local.get $bld))
  (call $clear_cellar (local.get $idx))
  (i32.const 0))

(func $a_demolish (param $idx i32) (result i32)
  (local $p i32)
  (if (i32.eqz (call $in_grid (local.get $idx))) (then (return (global.get $E_TILE_OUT))))
  (local.set $p (call $tile_ptr (local.get $idx)))
  (if (i32.eqz (i32.load8_u (local.get $p))) (then (return (global.get $E_BAD_ARG))))
  (if (i32.and (i32.eq (i32.load8_u (local.get $p)) (i32.const 2))
               (i32.eq (i32.load8_u offset=1 (local.get $p)) (global.get $BLD_GARAGE)))
    (then
      ;; slots after demolition = 1 + garages - 1
      (if (i32.lt_u (call $count_bld (global.get $BLD_GARAGE)) (i32.load8_u (global.get $S_TRUCK_COUNT)))
        (then (return (global.get $E_MAX))))))
  (call $clear_tile (local.get $idx))
  (call $clear_cellar (local.get $idx))
  (i32.const 0))

(func $a_upgrade_bld (param $idx i32) (result i32)
  (local $p i32) (local $cost i32)
  (if (i32.eqz (call $in_grid (local.get $idx))) (then (return (global.get $E_TILE_OUT))))
  (local.set $p (call $tile_ptr (local.get $idx)))
  (if (i32.ne (i32.load8_u (local.get $p)) (i32.const 2)) (then (return (global.get $E_NOT_BUILDING))))
  (if (i32.gt_u (i32.load8_u offset=1 (local.get $p)) (i32.const 3)) (then (return (global.get $E_BAD_ARG))))
  (if (i32.and (i32.load8_u offset=5 (local.get $p)) (i32.const 2)) (then (return (global.get $E_MAX))))
  (local.set $cost
    (i32.div_u (i32.mul (call $bal (global.get $T_BLD) (i32.load8_u offset=1 (local.get $p)) (i32.const 0))
                        (call $k (global.get $K_BLD_UPG_PCT)))
               (i32.const 10000)))
  (if (i32.lt_s (i32.load (global.get $S_CASH)) (local.get $cost)) (then (return (global.get $E_CASH))))
  (i32.store (global.get $S_CASH) (i32.sub (i32.load (global.get $S_CASH)) (local.get $cost)))
  (i32.store8 offset=5 (local.get $p) (i32.or (i32.load8_u offset=5 (local.get $p)) (i32.const 2)))
  (i32.const 0))

(func $a_set_recipe (param $idx i32) (param $row i32) (result i32)
  (local $p i32)
  (if (i32.eqz (call $in_grid (local.get $idx))) (then (return (global.get $E_TILE_OUT))))
  (local.set $p (call $tile_ptr (local.get $idx)))
  (if (i32.ne (i32.load8_u (local.get $p)) (i32.const 2)) (then (return (global.get $E_NOT_BUILDING))))
  (if (i32.eq (local.get $row) (i32.const 255))
    (then (i32.store8 offset=7 (local.get $p) (i32.const 0)) (return (i32.const 0))))
  (if (i32.ge_u (local.get $row) (i32.const 8)) (then (return (global.get $E_BAD_ARG))))
  (if (i32.ne (call $bal (global.get $T_RECIPE) (local.get $row) (i32.const 0))
              (i32.load8_u offset=1 (local.get $p)))
    (then (return (global.get $E_BAD_ARG))))
  (i32.store8 offset=7 (local.get $p) (i32.add (local.get $row) (i32.const 1)))
  (i32.const 0))

(func $a_buy_land (result i32)
  (local $g i32) (local $cost i32)
  (local.set $g (i32.load8_u (global.get $S_GRID)))
  (if (i32.ge_u (local.get $g) (call $k (global.get $K_MAX_GRID))) (then (return (global.get $E_MAX))))
  (local.set $cost (call $bal (global.get $T_LAND) (i32.sub (local.get $g) (call $k (global.get $K_START_GRID))) (i32.const 0)))
  (if (i32.lt_s (i32.load (global.get $S_CASH)) (local.get $cost)) (then (return (global.get $E_CASH))))
  (i32.store (global.get $S_CASH) (i32.sub (i32.load (global.get $S_CASH)) (local.get $cost)))
  (i32.store8 (global.get $S_GRID) (i32.add (local.get $g) (i32.const 1)))
  (i32.store8 (global.get $S_RINGS) (i32.add (i32.load8_u (global.get $S_RINGS)) (i32.const 1)))
  (i32.const 0))

(func $a_sell_stand (param $good i32) (param $qty i32) (result i32)
  (if (i32.or (i32.gt_u (local.get $good) (i32.const 12)) (i32.eqz (local.get $qty)))
    (then (return (global.get $E_BAD_ARG))))
  (if (i32.lt_u (call $inv_count (local.get $good)) (local.get $qty)) (then (return (global.get $E_NO_STOCK))))
  (drop (call $inv_take (local.get $good) (local.get $qty)))
  (i32.store (global.get $S_CASH)
    (i32.add (i32.load (global.get $S_CASH))
             (call $sell_units (i32.const 0) (local.get $good) (local.get $qty))))
  (i32.const 0))

(func $a_continue (result i32)
  (if (i32.ne (i32.load8_u (global.get $S_STATUS)) (global.get $ST_RESULTS)) (then (return (global.get $E_STATUS))))
  (i32.store8 (global.get $S_STATUS) (global.get $ST_ENDLESS))
  (i32.const 0))

(func $act (param $id i32) (param $a i32) (param $b i32) (param $c i32) (result i32)
  (local $st i32)
  (local.set $st (i32.load8_u (global.get $S_STATUS)))
  (if (i32.eq (local.get $id) (i32.const 19)) (then (return (call $a_continue))))
  (if (i32.and (i32.ne (local.get $st) (i32.const 0)) (i32.ne (local.get $st) (global.get $ST_ENDLESS)))
    (then (return (global.get $E_STATUS))))
  (if (i32.eq (local.get $id) (i32.const 1)) (then (return (call $a_plant (local.get $a) (local.get $b)))))
  (if (i32.eq (local.get $id) (i32.const 2)) (then (return (call $a_harvest (local.get $a)))))
  (if (i32.eq (local.get $id) (i32.const 3)) (then (return (call $a_harvest_all))))
  (if (i32.eq (local.get $id) (i32.const 4)) (then (return (call $a_build (local.get $a) (local.get $b)))))
  (if (i32.eq (local.get $id) (i32.const 5)) (then (return (call $a_demolish (local.get $a)))))
  (if (i32.eq (local.get $id) (i32.const 6)) (then (return (call $a_upgrade_bld (local.get $a)))))
  (if (i32.eq (local.get $id) (i32.const 7)) (then (return (call $a_set_recipe (local.get $a) (local.get $b)))))
  (if (i32.eq (local.get $id) (i32.const 8)) (then (return (call $a_buy_land))))
  (if (i32.eq (local.get $id) (i32.const 9)) (then (return (call $a_sell_stand (local.get $a) (local.get $b)))))
  (global.get $E_BAD_ARG))
