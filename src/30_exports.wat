;; Public surface (spec §14.1).
(export "memory"   (memory $mem))
(export "init"     (func $init))
(export "load"     (func $load))
(export "save_ptr" (func $save_ptr))
(export "save_len" (func $save_len))
(export "io_buf"   (func $io_buf))
(export "storage_cap"  (func $storage_cap))
(export "storage_used" (func $storage_used))
(export "season"       (func $season))
(export "rank"         (func $rank))
(export "act"          (func $act))
(export "end_day"      (func $end_day))
(export "truck_cap"     (func $truck_cap))

;; Test hooks.
(export "t_rng_seed"  (func $rng_seed))
(export "t_rng_next"  (func $rng_next))
(export "t_rng_range" (func $rng_range))
(export "t_bal"       (func $bal))

;; Phase 2 test hooks: set up state without going through actions.
(func $t_give (param $good i32) (param $qty i32) (param $age i32)
  (local $p i32)
  (local.set $p (call $inv_ptr (local.get $good) (local.get $age)))
  (i32.store16 (local.get $p) (i32.add (i32.load16_u (local.get $p)) (local.get $qty))))
(func $t_set_cash (param $v i32) (i32.store (global.get $S_CASH) (local.get $v)))
(func $t_put_bld (param $tile i32) (param $bld i32)
  (local $p i32)
  (local.set $p (call $tile_ptr (local.get $tile)))
  (i32.store8 (local.get $p) (i32.const 2))
  (i32.store8 offset=1 (local.get $p) (local.get $bld)))
(export "t_give"     (func $t_give))
(export "t_set_cash" (func $t_set_cash))
(export "t_put_bld"  (func $t_put_bld))
(export "t_take"     (func $inv_take))
(export "t_count"    (func $inv_count))

;; Weather and events (14_weather.wat).
(export "t_set_weather"     (func $t_set_weather))
(export "t_weather_roll"    (func $weather_roll))
(export "t_weather_advance" (func $weather_advance))
(export "t_events_tick"     (func $events_tick))
(export "t_event_mod"       (func $event_mod))
(export "t_event_active"    (func $event_active))
