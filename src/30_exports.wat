(func $t_cargo_take (param $t i32) (param $g i32) (param $q i32) (result i32)
  (call $cargo_take (call $truck_ptr (local.get $t)) (local.get $g) (local.get $q)))
(export "t_contract_roll" (func $contract_roll))
