;; ---------------------------------------------------------------- viewport / fit

(func $scene_viewport (param $x i32) (param $y i32) (param $w i32) (param $h i32)
  (global.set $vp_x (local.get $x)) (global.set $vp_y (local.get $y))
  (global.set $vp_w (local.get $w)) (global.set $vp_h (local.get $h))
  (call $scene_fit))

(func $scene_time (param $t i32) (global.set $sc_time (local.get $t)))

(func $scene_fit
  (local $x i32) (local $y i32) (local $w i32) (local $h i32) (local $n i32) (local $hw i32) (local $oy i32)
  (local.set $x (global.get $vp_x)) (local.set $y (global.get $vp_y))
  (local.set $w (global.get $vp_w)) (local.set $h (global.get $vp_h))
  (if (i32.le_s (local.get $w) (i32.const 0)) (then
    (local.set $x (i32.const 0))
    (local.set $y (i32.div_u (global.get $fb_h) (i32.const 12)))
    (local.set $w (global.get $fb_w))
    (local.set $h (i32.sub (i32.sub (global.get $fb_h) (local.get $y)) (i32.div_u (global.get $fb_h) (i32.const 5))))))
  (global.set $sc_g (call $clamp (i32.load8_u (global.get $S_GRID)) (i32.const 4) (i32.const 8)))
  (local.set $n (global.get $sc_g))
  ;; a selected plot outside the owned square (the next ring, wild land) is fitted in view too
  (if (i32.ge_s (global.get $sel_tile) (i32.const 0)) (then
    (local.set $n (call $imax (local.get $n) (i32.add (i32.const 1)
      (call $imax (i32.and (global.get $sel_tile) (i32.const 7)) (i32.and (i32.shr_u (global.get $sel_tile) (i32.const 3)) (i32.const 7))))))))
  ;; width: n tiles + a quarter tile of margin; height: n + 2 tiles (headroom for tall models)
  (local.set $hw (i32.div_s (i32.shl (local.get $w) (i32.const 2)) (i32.add (i32.shl (local.get $n) (i32.const 3)) (i32.const 1))))
  (local.set $oy (i32.div_s (local.get $h) (i32.add (local.get $n) (i32.const 2))))
  (local.set $hw (call $clamp (select (local.get $oy) (local.get $hw) (i32.lt_s (local.get $oy) (local.get $hw))) (i32.const 4) (i32.const 64)))
  (local.set $oy (i32.add (i32.add (local.get $y) (i32.shr_s (local.get $h) (i32.const 1)))
    (i32.sub (local.get $hw) (i32.shr_s (i32.mul (local.get $n) (local.get $hw)) (i32.const 1)))))
  (call $iso_set (i32.add (local.get $x) (i32.shr_s (local.get $w) (i32.const 1))) (local.get $oy) (local.get $hw))
  ;; horizon one tile above the back corner, but leave at least a fifth of the screen to the sky
  (local.set $y (i32.sub (local.get $oy) (local.get $hw)))
  (local.set $h (i32.sub (local.get $oy) (i32.shr_s (local.get $hw) (i32.const 2))))
  (local.set $w (i32.div_s (global.get $fb_h) (i32.const 5)))
  ;; (clamped twice: on a framebuffer shorter than 8 rows the floor of 8 must not win)
  (global.set $sc_hz (call $clamp (call $clamp (select (local.get $y) (select (local.get $w) (local.get $h) (i32.lt_s (local.get $w) (local.get $h)))
    (i32.ge_s (local.get $y) (local.get $w))) (i32.const 8) (global.get $fb_h)) (i32.const 0) (global.get $fb_h))))

;; ---------------------------------------------------------------- small helpers

(func $pi (param $i i32) (result i32) (call $pal (i32.load8_u (local.get $i))))   ;; palette idx at address
(func $tb (param $o i32) (result i32) (i32.load8_u (i32.add (global.get $SCD) (local.get $o))))
(func $sin (param $a i32) (result i32) (i32.load8_s (i32.add (global.get $SCD) (i32.and (local.get $a) (i32.const 15)))))
(func $mod (param $v i32) (param $m i32) (result i32)   ;; v mod m, m = 0 treated as 1 (tiny framebuffers)
  (i32.rem_u (local.get $v) (i32.or (local.get $m) (i32.eqz (local.get $m)))))

;; Condition mask: always | A or !A | B or !B | C or !C | D.
(func $mc (param $a i32) (param $b i32) (param $c i32) (param $d i32)
  (global.set $mcond (i32.or (i32.or (i32.or (i32.const 1)
      (i32.shl (i32.const 2) (i32.eqz (local.get $a))))
      (i32.shl (i32.const 8) (i32.eqz (local.get $b))))
    (i32.or (i32.shl (i32.const 32) (i32.eqz (local.get $c)))
            (i32.shl (i32.ne (local.get $d) (i32.const 0)) (i32.const 7))))))

;; Filled disc through the iso pixel sink (honours $pmode, so blended discs work too).
(func $disc (param $cx i32) (param $cy i32) (param $r i32) (param $c i32)
  (local $dy i32) (local $w i32) (local $rr i32)
  (if (i32.lt_s (local.get $r) (i32.const 1)) (then (return)))
  (local.set $r (call $clamp (local.get $r) (i32.const 1) (i32.const 400)))
  (local.set $w (local.get $r))
  (local.set $rr (i32.mul (local.get $r) (i32.add (local.get $r) (i32.const 1))))
  (loop $l
    (block $fit (loop $s
      (br_if $fit (i32.le_s (i32.add (i32.mul (local.get $w) (local.get $w)) (i32.mul (local.get $dy) (local.get $dy))) (local.get $rr)))
      (local.set $w (i32.sub (local.get $w) (i32.const 1)))
      (br $s)))
    (call $span (i32.sub (local.get $cx) (local.get $w)) (i32.add (i32.add (local.get $cx) (local.get $w)) (i32.const 1)) (i32.add (local.get $cy) (local.get $dy)) (local.get $c))
    (if (local.get $dy) (then
      (call $span (i32.sub (local.get $cx) (local.get $w)) (i32.add (i32.add (local.get $cx) (local.get $w)) (i32.const 1)) (i32.sub (local.get $cy) (local.get $dy)) (local.get $c))))
    (br_if $l (i32.le_s (local.tee $dy (i32.add (local.get $dy) (i32.const 1))) (local.get $r)))))

;; Vertical band c0 -> c1 over rows [y0, y1): flat c0 for the first third, a Bayer 4x4
;; dithered transition over the middle third, flat c1 for the last third (whole width).
(func $grad (param $y0 i32) (param $y1 i32) (param $c0 i32) (param $c1 i32)
  (local $y i32) (local $ye i32) (local $p i32) (local $e i32) (local $lv i32)
  (local $k0 i32) (local $k1 i32) (local $k2 i32) (local $k3 i32) (local $t i32)
  (if (i32.le_s (local.get $y1) (local.get $y0)) (then (return)))
  (local.set $y (call $clamp (local.get $y0) (i32.const 0) (global.get $fb_h)))
  (local.set $ye (call $clamp (local.get $y1) (i32.const 0) (global.get $fb_h)))
  (block $done (loop $l
    (br_if $done (i32.ge_s (local.get $y) (local.get $ye)))
    (local.set $lv (i32.sub (i32.div_s (i32.mul (i32.sub (local.get $y) (local.get $y0)) (i32.const 48)) (i32.sub (local.get $y1) (local.get $y0))) (i32.const 16)))
    (local.set $k0 (select (local.get $c1) (local.get $c0) (call $dither (i32.const 0) (local.get $y) (local.get $lv))))
    (local.set $k1 (select (local.get $c1) (local.get $c0) (call $dither (i32.const 1) (local.get $y) (local.get $lv))))
    (local.set $k2 (select (local.get $c1) (local.get $c0) (call $dither (i32.const 2) (local.get $y) (local.get $lv))))
    (local.set $k3 (select (local.get $c1) (local.get $c0) (call $dither (i32.const 3) (local.get $y) (local.get $lv))))
    (local.set $p (i32.add (global.get $R_FB) (i32.shl (i32.mul (local.get $y) (global.get $fb_w)) (i32.const 2))))
    (local.set $e (i32.add (local.get $p) (i32.shl (global.get $fb_w) (i32.const 2))))
    (block $rd (loop $lx
      (br_if $rd (i32.ge_u (local.get $p) (local.get $e)))
      (i32.store (local.get $p) (local.get $k0))
      (local.set $t (local.get $k0)) (local.set $k0 (local.get $k1)) (local.set $k1 (local.get $k2))
      (local.set $k2 (local.get $k3)) (local.set $k3 (local.get $t))
      (local.set $p (i32.add (local.get $p) (i32.const 4)))
      (br $lx)))
    (local.set $y (i32.add (local.get $y) (i32.const 1)))
    (br $l))))

;; Smooth value noise 0..255 along x (period per), for hill silhouettes.
(func $vn (param $x i32) (param $per i32) (param $s i32) (result i32)
  (local $k i32) (local $f i32) (local $a i32)
  (local.set $x (i32.add (local.get $x) (i32.const 4096)))
  (local.set $k (i32.div_u (local.get $x) (local.get $per)))
  (local.set $f (i32.div_u (i32.shl (i32.rem_u (local.get $x) (local.get $per)) (i32.const 8)) (local.get $per)))
  (local.set $f (i32.shr_u (i32.mul (i32.mul (local.get $f) (local.get $f)) (i32.sub (i32.const 768) (i32.shl (local.get $f) (i32.const 1)))) (i32.const 16)))
  (local.set $a (i32.and (call $noise (local.get $k) (local.get $s)) (i32.const 255)))
  (i32.add (local.get $a) (i32.shr_s (i32.mul (i32.sub (i32.and (call $noise (i32.add (local.get $k) (i32.const 1)) (local.get $s)) (i32.const 255)) (local.get $a)) (local.get $f)) (i32.const 8))))

;; Line between two packed screen points.
(func $pline (param $a i32) (param $b i32) (param $c i32)
  (call $line (i32.extend16_s (local.get $a)) (i32.shr_s (local.get $a) (i32.const 16))
              (i32.extend16_s (local.get $b)) (i32.shr_s (local.get $b) (i32.const 16)) (local.get $c)))

;; Vertical world quad between (x0,y0) and (x1,y1), z in [z0, z1].
(func $vquad (param $x0 i32) (param $y0 i32) (param $x1 i32) (param $y1 i32) (param $z0 i32) (param $z1 i32) (param $c i32)
  (local $a i32) (local $b i32) (local $d i32) (local $e i32)
  (local.set $a (call $iso_pk (local.get $x0) (local.get $y0) (local.get $z1)))
  (local.set $b (call $iso_pk (local.get $x1) (local.get $y1) (local.get $z1)))
  (local.set $d (call $iso_pk (local.get $x1) (local.get $y1) (local.get $z0)))
  (local.set $e (call $iso_pk (local.get $x0) (local.get $y0) (local.get $z0)))
  (call $poly4 (i32.extend16_s (local.get $a)) (i32.shr_s (local.get $a) (i32.const 16))
               (i32.extend16_s (local.get $b)) (i32.shr_s (local.get $b) (i32.const 16))
               (i32.extend16_s (local.get $d)) (i32.shr_s (local.get $d) (i32.const 16))
               (i32.extend16_s (local.get $e)) (i32.shr_s (local.get $e) (i32.const 16)) (local.get $c)))

;; ---------------------------------------------------------------- model interpreter

(func $model (param $m i32) (param $wx i32) (param $wy i32) (param $pass i32)
  (local $e i32)
  (local.set $e (i32.add (global.get $MODEL_ADDR) (i32.shl (local.get $m) (i32.const 2))))
  (call $mdraw (i32.load16_u (local.get $e))
    (i32.add (i32.load16_u (local.get $e)) (i32.shl (i32.load8_u offset=2 (local.get $e)) (i32.const 3)))
    (local.get $wx) (local.get $wy) (local.get $pass)))

(func $mheight (param $m i32) (result i32)
  (i32.load8_u offset=3 (i32.add (global.get $MODEL_ADDR) (i32.shl (local.get $m) (i32.const 2)))))

;; Draw records [p, e) at world offset (wx, wy). pass 0 = shadows only, 1 = everything else.
(func $mdraw (param $p i32) (param $e i32) (param $wx i32) (param $wy i32) (param $pass i32)
  (local $f i32) (local $t i32) (local $h i32) (local $x i32) (local $y i32) (local $z i32)
  (local $a i32) (local $b i32) (local $c i32) (local $q i32) (local $s i32) (local $i i32) (local $j i32)
  (local $hu i32) (local $sw i32)
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $p) (local.get $e)))
    (local.set $f (i32.load8_u (local.get $p)))
    (local.set $t (i32.and (local.get $f) (i32.const 7)))
    (local.set $h (i32.load8_u offset=7 (local.get $p)))
    (local.set $x (i32.add (local.get $wx) (i32.load8_s offset=1 (local.get $p))))
    (local.set $y (i32.add (local.get $wy) (i32.load8_s offset=2 (local.get $p))))
    (local.set $z (i32.load8_s offset=3 (local.get $p)))
    (local.set $a (i32.load8_u offset=4 (local.get $p)))
    (local.set $b (i32.load8_u offset=5 (local.get $p)))
    (local.set $c (i32.load8_u offset=6 (local.get $p)))
    (local.set $p (i32.add (local.get $p) (i32.const 8)))
    (if (i32.eq (local.get $t) (i32.const 4)) (then
      ;; rep: the next c records on an nx x ny grid, diagonals back to front
      (local.set $q (i32.add (local.get $p) (i32.shl (local.get $c) (i32.const 3))))
      (local.set $s (i32.const 0))
      (loop $ls
        (local.set $i (i32.const 0))
        (loop $li
          (local.set $j (i32.sub (local.get $s) (local.get $i)))
          (if (i32.and (i32.lt_u (local.get $j) (i32.shr_u (local.get $a) (i32.const 4)))
                       (i32.lt_u (local.get $i) (i32.and (local.get $a) (i32.const 15))))
            (then (call $mdraw (local.get $p) (local.get $q)
              (i32.add (local.get $wx) (i32.mul (local.get $i) (i32.and (local.get $b) (i32.const 15))))
              (i32.add (local.get $wy) (i32.mul (local.get $j) (i32.shr_u (local.get $b) (i32.const 4))))
              (local.get $pass))))
          (br_if $li (i32.le_s (local.tee $i (i32.add (local.get $i) (i32.const 1))) (local.get $s))))
        (br_if $ls (i32.lt_s (local.tee $s (i32.add (local.get $s) (i32.const 1)))
          (i32.sub (i32.add (i32.and (local.get $a) (i32.const 15)) (i32.shr_u (local.get $a) (i32.const 4))) (i32.const 1)))))
      (local.set $p (local.get $q))
      (br $l)))
    (br_if $l (i32.eqz (i32.and (global.get $mcond) (i32.shl (i32.const 1) (i32.shr_u (local.get $h) (i32.const 5))))))
    (br_if $l (i32.ne (i32.eq (local.get $t) (i32.const 5)) (i32.eqz (local.get $pass))))
    (local.set $hu (i32.and (local.get $h) (i32.const 15)))
    (if (global.get $rot) (then (local.set $hu (call $tb (i32.add (i32.const 16) (local.get $hu))))))
    ;; seasonal surfaces: snow in winter (evergreen GRASS2 stays), foliage turns orange / red in autumn
    (if (i32.and (local.get $f) (i32.const 16)) (then
      (if (i32.and (i32.eq (global.get $sc_sea) (i32.const 3)) (i32.ne (local.get $hu) (global.get $H_GRASS2)))
        (then (local.set $hu (global.get $H_PAPER))))
      (if (i32.eq (global.get $sc_sea) (i32.const 2)) (then
        (if (i32.eq (local.get $hu) (global.get $H_GRASS)) (then (local.set $hu (global.get $H_WHEAT))))
        (if (i32.eq (local.get $hu) (global.get $H_GRASS2)) (then (local.set $hu (global.get $H_BARN))))))))
    (global.set $outline (i32.eqz (i32.and (local.get $f) (i32.const 8))))
    (global.set $iso_spec (i32.and (i32.shr_u (local.get $f) (i32.const 5)) (i32.const 1)))
    (global.set $pmode (i32.and (i32.shr_u (local.get $f) (i32.const 6)) (i32.const 1)))
    (local.set $sw (select (global.get $sway) (i32.const 0) (i32.shr_u (local.get $f) (i32.const 7))))
    (global.set $iso_ox (i32.add (global.get $iso_ox) (local.get $sw)))
    (if (i32.eqz (local.get $t)) (then
      (call $iso_box (local.get $x) (local.get $y) (local.get $z) (local.get $a) (local.get $b) (local.get $c) (local.get $hu))))
    (if (i32.eq (local.get $t) (i32.const 1)) (then
      (call $iso_prism (local.get $x) (local.get $y) (local.get $z) (local.get $a) (local.get $b) (local.get $c) (local.get $hu)
        (i32.and (i32.shr_u (local.get $h) (i32.const 4)) (i32.const 1)))))
    (if (i32.eq (local.get $t) (i32.const 2)) (then
      (call $iso_cyl (local.get $x) (local.get $y) (local.get $z) (local.get $a) (local.get $c) (local.get $hu))))
    (if (i32.eq (local.get $t) (i32.const 3)) (then
      (call $iso_proj (local.get $x) (local.get $y) (local.get $z))
      (if (i32.and (local.get $h) (i32.const 16)) (then (global.set $bclip (global.get $sy))))
      (call $iso_sphere (global.get $sx) (global.get $sy)
        (i32.shr_u (i32.add (i32.mul (local.get $a) (global.get $iso_hw)) (i32.const 8)) (i32.const 4)) (local.get $hu))
      (global.set $bclip (i32.const 0x3FFFFFFF))))
    (if (i32.eq (local.get $t) (i32.const 5)) (then
      (global.set $iso_sl (local.get $c))
      (call $iso_shadow (local.get $x) (local.get $y) (local.get $a) (local.get $b))))
    (if (i32.eq (local.get $t) (i32.const 6)) (then
      (call $fx (local.get $a) (local.get $x) (local.get $y) (local.get $z) (local.get $b) (local.get $c) (local.get $hu) (local.get $f) (local.get $h))))
    (if (i32.eq (local.get $t) (i32.const 7)) (then
      (call $msub (local.get $a) (local.get $x) (local.get $y) (local.get $pass))))
    (global.set $iso_ox (i32.sub (global.get $iso_ox) (local.get $sw)))
    (global.set $outline (i32.const 1))
    (global.set $iso_spec (i32.const 0))
    (global.set $pmode (i32.const 0))
    (br $l))))

;; Sub-model: 255 = the crop growing in the current (greenhouse) tile, else a model id drawn
;; with every condition false (e.g. the truck parked in the Garage).
(func $msub (param $a i32) (param $x i32) (param $y i32) (param $pass i32)
  (local $mc i32) (local $rt i32) (local $g i32) (local $se i32)
  (local.set $mc (global.get $mcond))
  (local.set $rt (global.get $rot))
  (if (i32.eq (local.get $a) (i32.const 255))
    (then ;; the greenhouse crop grows in an eternal summer (no snow, autumn tint or bare tree)
      (local.set $g (i32.load8_u offset=6 (global.get $cur_p)))
      (local.set $se (global.get $sc_sea))
      (global.set $sc_sea (i32.const 1))
      (if (local.get $g) (then
        (call $model (call $crop_model (global.get $cur_p) (i32.sub (local.get $g) (i32.const 1)))
          (local.get $x) (local.get $y) (local.get $pass))))
      (global.set $sc_sea (local.get $se)))
    (else
      (call $mc (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0))
      (call $model (local.get $a) (local.get $x) (local.get $y) (local.get $pass))))
  (global.set $mcond (local.get $mc))
  (global.set $rot (local.get $rt)))

;; Crop c on tile p -> model id; sets conditions (A ripe, B winter, C spring) and rot.
(func $crop_model (param $p i32) (param $c i32) (result i32)
  (local $tg i32) (local $pr i32) (local $st i32)
  (local.set $c (call $clamp (local.get $c) (i32.const 0) (i32.const 4)))
  (local.set $tg (call $grow_target (local.get $p) (local.get $c)))
  (local.set $pr (i32.load16_u offset=2 (local.get $p)))
  (local.set $st (i32.div_u (i32.mul (local.get $pr) (i32.const 3)) (select (local.get $tg) (i32.const 1) (local.get $tg))))
  (if (i32.and (i32.eq (local.get $c) (global.get $CROP_APPLE)) (i32.and (i32.load8_u offset=5 (local.get $p)) (i32.const 1)))
    (then (local.set $st (i32.const 2))))
  (call $mc (i32.ge_u (local.get $pr) (local.get $tg)) (i32.eq (global.get $sc_sea) (i32.const 3))
    (i32.eqz (global.get $sc_sea)) (i32.const 0))
  (global.set $rot (i32.ne (i32.load8_u offset=4 (local.get $p)) (i32.const 0)))
  (if (i32.and (global.get $rot) (i32.ne (local.get $c) (global.get $CROP_APPLE)))
    (then (global.set $rot (i32.const 0)) (return (i32.const 31))))
  (i32.add (i32.mul (local.get $c) (i32.const 3)) (select (i32.const 2) (local.get $st) (i32.gt_u (local.get $st) (i32.const 2)))))

;; Model id for tile i (or -1), with its conditions, rot flag, current tile and sway set.
(func $tile_model (param $i i32) (result i32)
  (local $p i32) (local $k i32)
  (local.set $p (call $tile_ptr (local.get $i)))
  (global.set $cur_p (local.get $p))
  (global.set $rot (i32.const 0))
  (global.set $sway (i32.eq (i32.and (i32.add (i32.div_u (global.get $sc_t) (i32.const 400)) (i32.mul (local.get $i) (i32.const 3)))
                                     (i32.const 3)) (i32.const 1)))
  (if (i32.eqz (call $in_grid (local.get $i))) (then (return (i32.const -1))))
  (local.set $k (i32.load8_u (local.get $p)))
  (if (i32.eq (local.get $k) (i32.const 1))
    (then (return (call $crop_model (local.get $p) (i32.load8_u offset=1 (local.get $p))))))
  (if (i32.eq (local.get $k) (i32.const 2)) (then
    (call $mc (i32.and (i32.load8_u offset=5 (local.get $p)) (i32.const 2)) (i32.load8_u offset=7 (local.get $p))
      (i32.const 0) (i32.const 0))
    (return (i32.add (i32.const 15) (call $clamp (i32.load8_u offset=1 (local.get $p)) (i32.const 0) (i32.const 9))))))
  (i32.const -1))

;; ---------------------------------------------------------------- effects

;; Effects: 0 windmill sails, 1 smoke, 2 snowflake decal, 3 tuft of thin stems (s = height,
;; with grain heads when the record's axis bit is set), 4 unused, 5 world line segment
;; (s = dz, c = dx | dy << 4 as signed nibbles; 2 px (steps 2 and 0) unless no-outline).
(func $fx (param $k i32) (param $x i32) (param $y i32) (param $z i32) (param $s i32)
          (param $c i32) (param $hu i32) (param $f i32) (param $h i32)
  (local $q i32) (local $an i32) (local $sn i32) (local $cs i32) (local $hx i32) (local $hy i32)
  (local $ph i32) (local $r i32) (local $hw i32) (local $tx i32) (local $ty i32)
  (local.set $hw (global.get $iso_hw))
  (call $iso_proj (local.get $x) (local.get $y) (local.get $z))
  (local.set $hx (global.get $sx))
  (local.set $hy (global.get $sy))
  (if (i32.eq (local.get $k) (i32.const 3)) (then
    ;; five stems in a 3x3 footprint, leaning a little, tips sway
    (local.set $r (i32.shr_u (i32.mul (local.get $s) (local.get $hw)) (i32.const 4)))
    (loop $st
      (call $iso_proj (i32.add (local.get $x) (i32.rem_u (i32.mul (local.get $q) (i32.const 7)) (i32.const 3)))
                      (i32.add (local.get $y) (i32.rem_u (i32.mul (local.get $q) (i32.const 5)) (i32.const 3))) (local.get $z))
      (local.set $tx (i32.add (i32.add (global.get $sx) (i32.sub (i32.rem_u (local.get $q) (i32.const 3)) (i32.const 1))) (global.get $sway)))
      (local.set $ty (i32.sub (i32.sub (global.get $sy) (local.get $r)) (i32.and (local.get $q) (i32.const 1))))
      (call $line (global.get $sx) (global.get $sy) (local.get $tx) (local.get $ty)
        (call $hc (local.get $hu) (i32.add (i32.const 1) (i32.and (local.get $q) (i32.const 1)))))
      (if (i32.and (local.get $h) (i32.const 16)) (then
        (call $rect (local.get $tx) (i32.sub (local.get $ty) (i32.const 2)) (i32.const 2) (i32.const 3) (call $hc (local.get $hu) (i32.const 2)))
        (call $rect (local.get $tx) (i32.sub (local.get $ty) (i32.const 2)) (i32.const 1) (i32.const 2) (call $hc (local.get $hu) (i32.const 3)))))
      (br_if $st (i32.lt_u (local.tee $q (i32.add (local.get $q) (i32.const 1))) (i32.const 5))))
    (return)))
  (if (i32.eq (local.get $k) (i32.const 5)) (then
    (call $iso_proj (i32.add (local.get $x) (i32.shr_s (i32.shl (local.get $c) (i32.const 28)) (i32.const 28)))
                    (i32.add (local.get $y) (i32.shr_s (i32.shl (local.get $c) (i32.const 24)) (i32.const 28)))
                    (i32.add (local.get $z) (i32.extend8_s (local.get $s))))
    (local.set $tx (i32.add (global.get $sx) (select (global.get $sway) (i32.const 0) (i32.gt_s (i32.extend8_s (local.get $s)) (i32.const 0)))))
    (if (i32.and (local.get $f) (i32.const 8))
      (then (call $line (local.get $hx) (local.get $hy) (local.get $tx) (global.get $sy) (call $hc (local.get $hu) (i32.const 2))))
      (else
        (call $line (local.get $hx) (local.get $hy) (local.get $tx) (global.get $sy) (call $hc (local.get $hu) (i32.const 2)))
        (call $line (i32.add (local.get $hx) (i32.const 1)) (local.get $hy) (i32.add (local.get $tx) (i32.const 1)) (global.get $sy) (call $hc (local.get $hu) (i32.const 0)))))
    (return)))
  (if (i32.eqz (local.get $k)) (then
    ;; windmill sails in the x-z plane: turning while a recipe runs, else parked
    (local.set $an (select (i32.div_u (global.get $sc_t) (i32.const 90)) (i32.const 1) (i32.and (global.get $mcond) (i32.const 8))))
    (loop $l
      (local.set $cs (call $sin (i32.add (local.get $an) (i32.const 4))))
      (local.set $sn (call $sin (local.get $an)))
      (call $sail (local.get $hx) (local.get $hy) (local.get $cs) (local.get $sn) (local.get $s) (local.get $hw))
      (local.set $an (i32.add (local.get $an) (i32.const 4)))
      (br_if $l (i32.lt_u (local.tee $q (i32.add (local.get $q) (i32.const 1))) (i32.const 4))))
    (return)))
  (if (i32.eq (local.get $k) (i32.const 1)) (then
    ;; three smoke puffs rising and drifting with the wind, fading (blend) as they age
    (loop $p
      (local.set $ph (call $mod (i32.add (i32.div_u (global.get $sc_t) (i32.const 30)) (i32.mul (local.get $q) (i32.const 34))) (i32.const 100)))
      (call $iso_proj (i32.add (local.get $x) (i32.div_u (local.get $ph) (i32.const 9)))
        (i32.sub (local.get $y) (i32.div_u (local.get $ph) (i32.const 20))) (i32.add (local.get $z) (i32.div_u (local.get $ph) (i32.const 6))))
      (local.set $r (i32.shr_u (i32.add (i32.mul (local.get $hw) (i32.add (i32.const 2) (i32.div_u (local.get $ph) (i32.const 25)))) (i32.const 8)) (i32.const 4)))
      (global.set $pmode (i32.const 1))
      (call $disc (global.get $sx) (global.get $sy) (local.get $r) (call $hc (global.get $H_PAPER) (i32.const 3)))
      (if (i32.lt_u (local.get $ph) (i32.const 60))
        (then (call $disc (i32.sub (global.get $sx) (i32.const 1)) (i32.sub (global.get $sy) (i32.const 1)) (i32.shr_u (local.get $r) (i32.const 1))
          (call $hc (global.get $H_PAPER) (i32.const 3)))))
      (global.set $pmode (i32.const 0))
      (br_if $p (i32.lt_u (local.tee $q (i32.add (local.get $q) (i32.const 1))) (i32.const 3))))
    (return)))
  ;; snowflake decal
  (local.set $r (i32.add (i32.shr_u (i32.mul (local.get $s) (local.get $hw)) (i32.const 4)) (i32.const 1)))
  (local.set $q (call $hc (global.get $H_WATER) (i32.const 1)))
  (call $line (i32.sub (local.get $hx) (local.get $r)) (local.get $hy) (i32.add (local.get $hx) (local.get $r)) (local.get $hy) (local.get $q))
  (call $line (i32.sub (local.get $hx) (i32.shr_s (local.get $r) (i32.const 1))) (i32.sub (local.get $hy) (local.get $r))
              (i32.add (local.get $hx) (i32.shr_s (local.get $r) (i32.const 1))) (i32.add (local.get $hy) (local.get $r)) (local.get $q))
  (call $line (i32.add (local.get $hx) (i32.shr_s (local.get $r) (i32.const 1))) (i32.sub (local.get $hy) (local.get $r))
              (i32.sub (local.get $hx) (i32.shr_s (local.get $r) (i32.const 1))) (i32.add (local.get $hy) (local.get $r)) (local.get $q)))

;; One sail: blade along (cs, sn)/64 in the x-z plane from r = 2 to s, cloth on one side.
;; Screen per world unit: +x = (hw/16, hw/32), +z = (0, -hw/16); fixed point /1024.
(func $sail (param $hx i32) (param $hy i32) (param $cs i32) (param $sn i32) (param $s i32) (param $hw i32)
  (local $ax i32) (local $ay i32) (local $bx i32) (local $by i32) (local $ox i32) (local $oy i32)
  (local.set $ax (i32.add (local.get $hx) (i32.shr_s (i32.mul (i32.mul (local.get $cs) (i32.const 2)) (local.get $hw)) (i32.const 10))))
  (local.set $ay (i32.add (local.get $hy) (i32.shr_s (i32.mul (i32.sub (local.get $cs) (i32.shl (local.get $sn) (i32.const 1))) (local.get $hw)) (i32.const 10))))
  (local.set $bx (i32.add (local.get $hx) (i32.shr_s (i32.mul (i32.mul (local.get $cs) (local.get $s)) (local.get $hw)) (i32.const 10))))
  (local.set $by (i32.add (local.get $hy) (i32.shr_s (i32.mul (i32.mul (i32.sub (local.get $cs) (i32.shl (local.get $sn) (i32.const 1))) (local.get $s)) (local.get $hw)) (i32.const 11))))
  ;; cloth offset: perpendicular (-sn, cs) * 3 units
  (local.set $ox (i32.shr_s (i32.mul (i32.mul (i32.sub (i32.const 0) (local.get $sn)) (i32.const 3)) (local.get $hw)) (i32.const 10)))
  (local.set $oy (i32.shr_s (i32.mul (i32.mul (i32.sub (i32.sub (i32.const 0) (local.get $sn)) (i32.shl (local.get $cs) (i32.const 1))) (i32.const 3)) (local.get $hw)) (i32.const 11)))
  (call $poly4 (local.get $ax) (local.get $ay) (local.get $bx) (local.get $by)
    (i32.add (local.get $bx) (local.get $ox)) (i32.add (local.get $by) (local.get $oy))
    (i32.add (local.get $ax) (local.get $ox)) (i32.add (local.get $ay) (local.get $oy)) (call $hc (global.get $H_PAPER) (i32.const 2)))
  (call $line (local.get $hx) (local.get $hy) (local.get $bx) (local.get $by) (call $hc (global.get $H_WOOD) (i32.const 0))))

;; ---------------------------------------------------------------- backdrop

;; Look index: weather first, otherwise season.
(func $look (result i32)
  (local $l i32)
  (local.set $l (call $tb (i32.add (i32.const 160) (global.get $sc_wx))))
  (if (result i32) (i32.eq (local.get $l) (i32.const 255))
    (then (call $tb (i32.add (i32.const 166) (global.get $sc_sea))))
    (else (local.get $l))))

(func $backdrop (param $L i32)
  (local $a i32) (local $b i32) (local $c i32) (local $x i32) (local $y i32) (local $r i32) (local $i i32)
  (local $n i32) (local $s i32) (local $w i32) (local $k i32) (local $far i32) (local $near i32) (local $hz i32) (local $hw i32)
  (local.set $hz (global.get $sc_hz))
  (local.set $hw (global.get $iso_hw))
  (local.set $a (i32.add (global.get $SCD) (i32.add (i32.const 32) (i32.mul (local.get $L) (i32.const 3)))))
  (local.set $c (call $pi (i32.add (local.get $a) (i32.const 2))))
  (local.set $y (i32.div_u (i32.mul (local.get $hz) (i32.const 3)) (i32.const 5)))
  (call $grad (i32.const 0) (local.get $y) (call $pi (local.get $a)) (call $pi (i32.add (local.get $a) (i32.const 1))))
  (call $grad (local.get $y) (local.get $hz) (call $pi (i32.add (local.get $a) (i32.const 1))) (local.get $c))
  (local.set $a (i32.add (global.get $SCD) (i32.add (i32.const 56) (i32.shl (local.get $L) (i32.const 1)))))
  (local.set $far (call $pi (local.get $a)))
  (local.set $near (call $pi (i32.add (local.get $a) (i32.const 1))))
  (if (i32.eq (local.get $L) (i32.const 5)) (then   ;; frost: hoarfrost on the meadow
    (local.set $far (call $mix (local.get $far) (call $hc (global.get $H_SKY) (i32.const 3)) (i32.const 8)))
    (local.set $near (call $mix (local.get $near) (call $hc (global.get $H_SKY) (i32.const 3)) (i32.const 6)))))
  (call $grad (local.get $hz) (i32.add (local.get $hz) (i32.mul (local.get $hw) (i32.const 3))) (local.get $far) (local.get $near))
  (call $grad (i32.add (local.get $hz) (i32.mul (local.get $hw) (i32.const 3))) (global.get $fb_h) (local.get $near)
    (call $mix (local.get $near) (call $hc (global.get $H_INK) (i32.const 1)) (i32.const 2)))
  ;; meadow texture: sparse grass strokes, denser toward the viewer (winter: soft drift lines)
  (local.set $b (call $mix (local.get $near) (call $hc (global.get $H_INK) (i32.const 1)) (i32.const 4)))
  (if (i32.eq (local.get $L) (i32.const 5)) (then (local.set $b (call $hc (global.get $H_PAPER) (i32.const 3)))))
  (if (i32.eq (local.get $L) (i32.const 2)) (then (local.set $b (call $hc (global.get $H_SKY) (i32.const 2))) (global.set $pmode (i32.const 1))))
  (local.set $n (i32.div_u (i32.mul (global.get $fb_w) (i32.sub (global.get $fb_h) (local.get $hz))) (i32.const 220)))
  (local.set $i (i32.const 0))
  (block $td (loop $tl
    (br_if $td (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $k (call $noise (local.get $i) (i32.xor (global.get $sc_seed) (i32.const 0x3c))))
    (local.set $x (call $mod (local.get $k) (global.get $fb_w)))
    (local.set $y (i32.add (local.get $hz) (i32.add (i32.const 2) (call $mod (i32.shr_u (local.get $k) (i32.const 12)) (i32.sub (global.get $fb_h) (local.get $hz))))))
    (if (global.get $pmode)
      (then (call $span (local.get $x) (i32.add (local.get $x) (i32.add (i32.const 3) (i32.and (local.get $k) (i32.const 7)))) (local.get $y) (local.get $b)))
      (else
        (call $px (local.get $x) (local.get $y) (local.get $b))
        (call $px (i32.add (local.get $x) (i32.const 1)) (i32.sub (local.get $y) (i32.const 1)) (local.get $b))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $tl)))
  (global.set $pmode (i32.const 0))
  ;; sun (hidden by rain and storm), upper left: soft blended halo, bright core
  (if (i32.eqz (i32.and (i32.ge_u (local.get $L) (i32.const 3)) (i32.le_u (local.get $L) (i32.const 4)))) (then
    (local.set $r (i32.add (i32.const 5) (i32.div_u (local.get $hw) (i32.const 3))))
    (local.set $x (i32.div_u (global.get $fb_w) (i32.const 5)))
    (local.set $y (i32.div_u (i32.mul (local.get $hz) (i32.const 2)) (i32.const 5)))
    (global.set $pmode (i32.const 1))
    (if (i32.eq (local.get $L) (i32.const 6)) (then   ;; heatwave: a wide glare
      (local.set $r (i32.add (local.get $r) (i32.shr_u (local.get $r) (i32.const 1))))
      (call $disc (local.get $x) (local.get $y) (i32.mul (local.get $r) (i32.const 3)) (call $hc (global.get $H_CORN) (i32.const 3)))))
    (call $disc (local.get $x) (local.get $y) (i32.shl (local.get $r) (i32.const 1)) (call $hc (global.get $H_PAPER) (i32.const 3)))
    (call $disc (local.get $x) (local.get $y) (i32.div_u (i32.mul (local.get $r) (i32.const 3)) (i32.const 2)) (call $hc (global.get $H_WHEAT) (i32.const 3)))
    (global.set $pmode (i32.const 0))
    (call $disc (local.get $x) (local.get $y) (local.get $r) (call $hc (global.get $H_WHEAT) (i32.const 3)))
    (call $disc (local.get $x) (local.get $y) (i32.sub (local.get $r) (select (i32.const 1) (i32.const 2) (i32.eq (local.get $L) (i32.const 6))))
      (call $hc (global.get $H_PAPER) (i32.const 3)))))
  ;; clouds: puffs drawn twice, shaded underside first, drifting with time; clipped above the
  ;; lowest possible far-hill top so no puff ever shows below the hill line
  (global.set $cy1 (i32.sub (local.get $hz) (i32.shr_u (local.get $hw) (i32.const 2))))
  (local.set $n (i32.add (i32.add (i32.const 2) (i32.div_u (global.get $fb_w) (i32.const 160)))
    (select (i32.const 3) (i32.const 0) (i32.and (i32.ge_u (local.get $L) (i32.const 3)) (i32.le_u (local.get $L) (i32.const 4))))))
  (local.set $a (call $hc (select (global.get $H_STONE) (global.get $H_SKY) (i32.and (i32.ge_u (local.get $L) (i32.const 3)) (i32.le_u (local.get $L) (i32.const 4)))) (i32.const 2)))
  (local.set $b (call $hc (select (global.get $H_STONE) (global.get $H_PAPER) (i32.and (i32.ge_u (local.get $L) (i32.const 3)) (i32.le_u (local.get $L) (i32.const 4)))) (i32.const 3)))
  (local.set $i (i32.const 0))
  (block $cd (loop $cl
    (br_if $cd (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $s (i32.div_u (i32.mul (i32.add (i32.const 8) (call $mod (call $noise (local.get $i) (i32.const 3)) (i32.const 8))) (local.get $hw)) (i32.const 24)))
    (local.set $w (i32.add (global.get $fb_w) (i32.shl (local.get $s) (i32.const 3))))
    (local.set $x (i32.sub (call $mod (i32.add (call $mod (call $noise (local.get $i) (i32.const 1)) (local.get $w))
      (i32.div_u (i32.mul (call $mod (global.get $sc_t) (i32.const 3600000)) (i32.add (i32.const 1) (call $mod (local.get $i) (i32.const 3)))) (i32.const 900)))
      (local.get $w)) (i32.shl (local.get $s) (i32.const 2))))
    (local.set $y (i32.add (i32.add (i32.const 4) (local.get $s)) (call $mod (call $noise (local.get $i) (i32.const 2))
      (i32.add (i32.const 1) (i32.sub (i32.div_u (i32.mul (local.get $hz) (i32.const 2)) (i32.const 3)) (local.get $s))))))
    (local.set $k (i32.const 0))
    (loop $pk
      (local.set $c (i32.add (global.get $SCD) (i32.add (i32.const 96) (i32.mul (i32.rem_u (local.get $k) (i32.const 5)) (i32.const 3)))))
      (call $disc (i32.add (local.get $x) (i32.shr_s (i32.mul (i32.load8_s (local.get $c)) (local.get $s)) (i32.const 3)))
        (i32.add (i32.add (local.get $y) (i32.shr_s (i32.mul (i32.load8_s offset=1 (local.get $c)) (local.get $s)) (i32.const 3)))
                 (select (i32.shr_u (local.get $s) (i32.const 2)) (i32.const 0) (i32.lt_u (local.get $k) (i32.const 5))))
        (i32.shr_u (i32.mul (i32.load8_s offset=2 (local.get $c)) (local.get $s)) (i32.const 3))
        (select (local.get $a) (local.get $b) (i32.lt_u (local.get $k) (i32.const 5))))
      (br_if $pk (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1))) (i32.const 10))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $cl)))
  (global.set $cy1 (i32.const 0x3FFFFFFF))
  ;; hills: far (blended toward the horizon sky) then near, per column
  (local.set $near (call $pi (i32.add (global.get $SCD) (i32.add (i32.const 72) (local.get $L)))))
  (local.set $far (call $blend50 (local.get $near) (call $pi (i32.add (global.get $SCD) (i32.add (i32.const 34) (i32.mul (local.get $L) (i32.const 3)))))))
  (local.set $x (i32.const 0))
  (block $hd (loop $hl
    (br_if $hd (i32.ge_s (local.get $x) (global.get $fb_w)))
    (local.set $y (i32.sub (local.get $hz) (i32.add (i32.shr_u (local.get $hw) (i32.const 2))
      (i32.shr_u (i32.mul (call $vn (local.get $x) (i32.add (i32.mul (local.get $hw) (i32.const 3)) (i32.const 1)) (i32.xor (global.get $sc_seed) (i32.const 0x51))) (local.get $hw)) (i32.const 8)))))
    (call $rect (local.get $x) (local.get $y) (i32.const 1) (i32.sub (local.get $hz) (local.get $y)) (local.get $far))
    (local.set $y (i32.sub (local.get $hz) (i32.add (i32.const 1)
      (i32.shr_u (i32.mul (call $vn (local.get $x) (i32.add (i32.shl (local.get $hw) (i32.const 1)) (i32.const 1)) (i32.xor (global.get $sc_seed) (i32.const 0x77))) (local.get $hw)) (i32.const 9)))))
    (call $rect (local.get $x) (local.get $y) (i32.const 1) (i32.sub (local.get $hz) (local.get $y)) (local.get $near))
    (call $px (local.get $x) (local.get $y) (local.get $far))
    (local.set $x (i32.add (local.get $x) (i32.const 1)))
    (br $hl)))
  (if (i32.eq (local.get $L) (i32.const 6)) (then
    ;; heatwave: orange-yellow haze over the horizon, solid core, streaky fringes
    (global.set $pmode (i32.const 1))
    (local.set $y (i32.sub (local.get $hz) (local.get $hw)))
    (local.set $c (call $hc (global.get $H_WHEAT) (i32.const 2)))
    (block $zd (loop $zl
      (br_if $zd (i32.ge_s (local.get $y) (i32.add (local.get $hz) (i32.shr_u (local.get $hw) (i32.const 1)))))
      (if (i32.or (i32.lt_u (i32.add (i32.sub (local.get $y) (local.get $hz)) (i32.shr_u (local.get $hw) (i32.const 2))) (i32.shr_u (local.get $hw) (i32.const 1)))
                  (i32.eqz (i32.and (call $noise (local.get $y) (i32.const 71)) (i32.const 1))))
        (then (call $span (i32.const 0) (global.get $fb_w) (local.get $y) (local.get $c))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br $zl)))
    (global.set $pmode (i32.const 0)))))

;; Meadow trees and bushes (front = 0: those behind the road; 1: those left of the slab).
(func $props (param $front i32)
  (local $k i32) (local $e i32)
  (loop $l
    (local.set $e (i32.add (global.get $SCD) (i32.add (i32.const 112) (i32.mul (local.get $k) (i32.const 3)))))
    (if (i32.and (i32.eq (i32.ge_s (i32.load8_s offset=1 (local.get $e)) (i32.const 0)) (local.get $front))
                 (call $onscreen (i32.load8_s (local.get $e)) (i32.load8_s offset=1 (local.get $e)))) (then
      (call $mc (i32.const 0) (i32.eq (global.get $sc_sea) (i32.const 3)) (i32.eqz (global.get $sc_sea)) (i32.const 0))
      (global.set $rot (i32.const 0))
      (global.set $sway (i32.const 0))
      (call $model (i32.load8_u offset=2 (local.get $e)) (i32.sub (i32.load8_s (local.get $e)) (i32.const 8))
        (i32.sub (i32.load8_s offset=1 (local.get $e)) (i32.const 8)) (i32.const 0))
      (call $model (i32.load8_u offset=2 (local.get $e)) (i32.sub (i32.load8_s (local.get $e)) (i32.const 8))
        (i32.sub (i32.load8_s offset=1 (local.get $e)) (i32.const 8)) (i32.const 1))))
    (br_if $l (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1))) (i32.const 8)))))

;; Meadow props in front of the slab (on the meadow, 16 units below the slab top).
(func $props_front
  (local $k i32) (local $e i32) (local $oy i32)
  (local.set $oy (global.get $iso_oy))
  (call $iso_set (global.get $iso_ox) (i32.add (local.get $oy) (global.get $iso_hw)) (global.get $iso_hw))
  (call $mc (i32.const 0) (i32.eq (global.get $sc_sea) (i32.const 3)) (i32.eqz (global.get $sc_sea)) (i32.const 0))
  (global.set $rot (i32.const 0))
  (global.set $sway (i32.const 0))
  (loop $l
    (local.set $e (i32.add (global.get $SCD) (i32.add (i32.const 170) (i32.mul (local.get $k) (i32.const 3)))))
    (if (call $onscreen (i32.load8_u (local.get $e)) (i32.load8_u offset=1 (local.get $e))) (then
      (call $model (i32.load8_u offset=2 (local.get $e)) (i32.sub (i32.load8_u (local.get $e)) (i32.const 8))
        (i32.sub (i32.load8_u offset=1 (local.get $e)) (i32.const 8)) (i32.const 0))
      (call $model (i32.load8_u offset=2 (local.get $e)) (i32.sub (i32.load8_u (local.get $e)) (i32.const 8))
        (i32.sub (i32.load8_u offset=1 (local.get $e)) (i32.const 8)) (i32.const 1))))
    (br_if $l (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1))) (i32.const 8))))
  (call $iso_set (global.get $iso_ox) (local.get $oy) (global.get $iso_hw)))

;; 1 when a meadow prop centred on ground point (x, y) fits on screen: a box of +-hw
;; around it (crown, shadow, pond rim) inside the framebuffer, bottom with hw/2 to spare.
(func $onscreen (param $x i32) (param $y i32) (result i32)
  (local $hw i32)
  (local.set $hw (global.get $iso_hw))
  (call $iso_proj (local.get $x) (local.get $y) (i32.const 0))
  (i32.and (i32.and (i32.ge_s (global.get $sx) (local.get $hw))
                    (i32.le_s (i32.add (global.get $sx) (local.get $hw)) (global.get $fb_w)))
           (i32.le_s (i32.add (global.get $sy) (i32.shr_u (local.get $hw) (i32.const 1))) (global.get $fb_h))))

;; Road x where its centre line meets the horizon.
(func $road_end (result i32)
  (i32.add (i32.div_s (i32.shl (i32.sub (global.get $sc_hz) (global.get $iso_oy)) (i32.const 5)) (global.get $iso_hw)) (i32.const 9)))

(func $road
  (local $x i32) (local $w i32) (local $c i32)
  (local.set $x (i32.sub (call $road_end) (i32.const 24)))
  (local.set $w (i32.sub (i32.const 220) (local.get $x)))
  (local.set $c (select (global.get $H_PAPER) (global.get $H_SOIL) (i32.eq (global.get $sc_sea) (i32.const 3))))
  ;; verge (dark grass; snow in winter), surface y = -17..-2 (two lanes), wheel ruts
  (call $iso_quad (local.get $x) (i32.const -18) (i32.const 0) (local.get $w) (i32.const 17)
    (select (call $hc (global.get $H_PAPER) (i32.const 3)) (call $hc (global.get $H_GRASS) (i32.const 0)) (i32.eq (global.get $sc_sea) (i32.const 3))))
  (call $iso_quad (local.get $x) (i32.const -17) (i32.const 0) (local.get $w) (i32.const 15) (call $hc (local.get $c) (i32.const 2)))
  (call $iso_quad (local.get $x) (i32.const -13) (i32.const 0) (local.get $w) (i32.const 1) (call $hc (local.get $c) (i32.const 1)))
  (call $iso_quad (local.get $x) (i32.const -7) (i32.const 0) (local.get $w) (i32.const 1) (call $hc (local.get $c) (i32.const 1))))

;; Trucks: parked at the farm gate when home, else on the road toward the horizon, shrinking
;; with distance (fake perspective: hw scaled by (512 - u) / 512, u = 0..255 along the road).
;; $truck_pos(i) -> depth key x + lane y + 64 (packed with u << 16), or -1 when truck i is
;; not present; parked trucks sit on the middle lane (y = -9).
(func $truck_pos (param $i i32) (result i32)
  (local $p i32) (local $ph i32) (local $dl i32) (local $tot i32) (local $u i32) (local $x0 i32)
  (if (i32.ge_u (local.get $i) (call $clamp (i32.load8_u (global.get $S_TRUCK_COUNT)) (i32.const 0) (i32.const 3))) (then (return (i32.const -1))))
  (local.set $p (i32.add (global.get $S_TRUCKS) (i32.mul (local.get $i) (global.get $TRUCK_STRIDE))))
  (if (i32.eqz (i32.load8_u (local.get $p))) (then (return (i32.const -1))))
  ;; bay 0 at the gate, pulled in so the parked truck's right end stays on screen
  (local.set $x0 (i32.sub (i32.shl (global.get $sc_g) (i32.const 4)) (i32.const 10)))
  (local.set $u (i32.sub (i32.div_s (i32.shl (i32.sub (i32.sub (global.get $fb_w) (i32.const 4)) (global.get $iso_ox)) (i32.const 4))
    (global.get $iso_hw)) (i32.const 19)))
  (if (i32.lt_s (local.get $u) (local.get $x0)) (then (local.set $x0 (local.get $u))))
  (local.set $ph (i32.load8_u offset=2 (local.get $p)))
  (if (i32.eqz (local.get $ph)) (then (return (i32.add (i32.sub (local.get $x0) (i32.shl (local.get $i) (i32.const 4))) (i32.const 55)))))
  ;; daysLeft >= 1 (0 never occurs in play; crafted / corrupt states must not wrap)
  (local.set $dl (i32.load8_u offset=3 (local.get $p)))
  (if (i32.eqz (local.get $dl)) (then (local.set $dl (i32.const 1))))
  (local.set $tot (call $bal (global.get $T_MKT) (call $clamp (i32.load8_u offset=1 (local.get $p)) (i32.const 0) (i32.const 2)) (i32.const 2)))
  (if (i32.lt_u (local.get $tot) (local.get $dl)) (then (local.set $tot (local.get $dl))))
  ;; out: (tot - dl + 1) / (tot + 1) of the way; back: (dl - 1/2) / (tot + 1), so trucks meeting on
  ;; the same day never coincide
  (local.set $u (i32.div_u (select (i32.shl (i32.add (i32.sub (local.get $tot) (local.get $dl)) (i32.const 1)) (i32.const 8))
    (i32.sub (i32.shl (local.get $dl) (i32.const 8)) (i32.const 128))
    (i32.eq (local.get $ph) (i32.const 1))) (i32.add (local.get $tot) (i32.const 1))))
  ;; travel starts past the three parking bays; outbound trucks use the near lane (y = -5),
  ;; returning ones the far lane (y = -14): a returning truck is nearer home (+x) and on the
  ;; far lane (-y), so on screen it sits to the right of an outbound one instead of on it
  (local.set $x0 (i32.sub (local.get $x0) (i32.const 36)))
  (i32.or (i32.shl (local.get $u) (i32.const 16))
    (i32.add (i32.sub (local.get $x0) (i32.shr_s (i32.mul (i32.sub (local.get $x0) (call $road_end)) (local.get $u)) (i32.const 8)))
      (select (i32.const 59) (i32.const 50) (i32.eq (local.get $ph) (i32.const 1))))))

(func $trucks
  (local $i i32) (local $k i32) (local $v i32) (local $best i32) (local $bi i32) (local $last i32) (local $p i32) (local $u i32)
  (local $ox i32) (local $oy i32) (local $hw i32)
  (local.set $ox (global.get $iso_ox)) (local.set $oy (global.get $iso_oy)) (local.set $hw (global.get $iso_hw))
  (local.set $last (i32.const -1))
  (loop $pass
    ;; next truck by increasing road x (back to front); ties by index
    (local.set $best (i32.const 0x7FFFFFFF))
    (local.set $bi (i32.const -1))
    (local.set $i (i32.const 0))
    (loop $scan
      (local.set $v (call $truck_pos (local.get $i)))
      (if (i32.ge_s (local.get $v) (i32.const 0)) (then
        (local.set $v (i32.or (i32.shl (i32.and (local.get $v) (i32.const 0xFFFF)) (i32.const 2)) (local.get $i)))
        (if (i32.and (i32.gt_s (local.get $v) (local.get $last)) (i32.lt_s (local.get $v) (local.get $best)))
          (then (local.set $best (local.get $v)) (local.set $bi (local.get $i))))))
      (br_if $scan (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (i32.const 3))))
    (if (i32.ge_s (local.get $bi) (i32.const 0)) (then
      (local.set $last (local.get $best))
      (local.set $v (call $truck_pos (local.get $bi)))
      (local.set $u (i32.shr_u (local.get $v) (i32.const 16)))
      (local.set $p (i32.add (global.get $S_TRUCKS) (i32.mul (local.get $bi) (global.get $TRUCK_STRIDE))))
      (call $mc (i32.and (i32.load8_u offset=4 (local.get $p)) (i32.const 4)) (i32.and (i32.load8_u offset=4 (local.get $p)) (i32.const 8))
        (i32.const 0) (i32.const 0))
      (global.set $rot (i32.const 0))
      (global.set $sway (i32.const 0))
      (local.set $k (select (i32.const -5) (select (i32.const -14) (i32.const -9) (i32.eq (i32.load8_u offset=2 (local.get $p)) (i32.const 2)))
        (i32.eq (i32.load8_u offset=2 (local.get $p)) (i32.const 1))))
      (call $iso_proj (i32.sub (i32.sub (i32.and (local.get $v) (i32.const 0xFFFF)) (i32.const 64)) (local.get $k)) (local.get $k) (i32.const 0))
      (call $iso_set (global.get $sx) (global.get $sy) (i32.shr_u (i32.mul (local.get $hw) (i32.sub (i32.const 512) (local.get $u))) (i32.const 9)))
      (local.set $k (select (i32.const 26) (i32.const 25) (i32.eq (i32.load8_u offset=2 (local.get $p)) (i32.const 2))))
      (call $model (local.get $k) (i32.const -7) (i32.const -4) (i32.const 0))
      (call $model (local.get $k) (i32.const -7) (i32.const -4) (i32.const 1))
      (call $iso_set (local.get $ox) (local.get $oy) (local.get $hw))
      (br $pass)))))

;; Front side faces of the 8x8 slab in strata (grass lip, soil, dark base).
(func $slab
  (local $k i32) (local $z0 i32) (local $z1 i32) (local $h i32)
  (loop $l
    (local.set $z1 (select (i32.const 0) (select (i32.const -2) (i32.const -9) (i32.eq (local.get $k) (i32.const 1))) (i32.eqz (local.get $k))))
    (local.set $z0 (select (i32.const -2) (select (i32.const -9) (i32.const -16) (i32.eq (local.get $k) (i32.const 1))) (i32.eqz (local.get $k))))
    (local.set $h (select (select (global.get $H_PAPER) (global.get $H_GRASS) (i32.eq (global.get $sc_sea) (i32.const 3)))
      (select (global.get $H_SOIL) (global.get $H_TILLED) (i32.eq (local.get $k) (i32.const 1))) (i32.eqz (local.get $k))))
    (call $vquad (i32.const 0) (i32.const 128) (i32.const 128) (i32.const 128) (local.get $z0) (local.get $z1) (call $hc (local.get $h) (i32.const 2)))
    (call $vquad (i32.const 128) (i32.const 128) (i32.const 128) (i32.const 0) (local.get $z0) (local.get $z1) (call $hc (local.get $h) (i32.const 1)))
    (br_if $l (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1))) (i32.const 3))))
  (call $pline (call $iso_pk (i32.const 0) (i32.const 128) (i32.const -16)) (call $iso_pk (i32.const 128) (i32.const 128) (i32.const -16))
    (call $hc (global.get $H_TILLED) (i32.const 0)))
  (call $pline (call $iso_pk (i32.const 128) (i32.const 128) (i32.const -16)) (call $iso_pk (i32.const 128) (i32.const 0) (i32.const -16))
    (call $hc (global.get $H_TILLED) (i32.const 0))))

;; ---------------------------------------------------------------- terrain

;; Ground colour row: 0 spring 1 summer 2 autumn 3 winter 4 drought.
(func $grow_row (result i32)
  (if (result i32) (i32.eq (global.get $sc_wx) (i32.const 4)) (then (i32.const 5))
    (else (select (i32.const 4) (global.get $sc_sea) (i32.eq (global.get $sc_wx) (i32.const 2))))))

(func $ground (param $i i32)
  (local $wx i32) (local $wy i32) (local $p i32) (local $own i32) (local $n i32) (local $row i32)
  (local $c i32) (local $k i32) (local $q i32) (local $dk i32) (local $lt i32) (local $bed i32) (local $glow i32)
  (local.set $wx (i32.shl (i32.and (local.get $i) (i32.const 7)) (i32.const 4)))
  (local.set $wy (i32.shl (i32.shr_u (local.get $i) (i32.const 3)) (i32.const 4)))
  (local.set $p (call $tile_ptr (local.get $i)))
  (local.set $own (call $in_grid (local.get $i)))
  (local.set $n (call $noise (local.get $i) (global.get $sc_seed)))
  (local.set $row (i32.add (global.get $SCD) (i32.add (i32.const 136) (i32.shl (call $grow_row) (i32.const 2)))))
  (local.set $bed (i32.and (local.get $own) (i32.ne (i32.load8_u (local.get $p)) (i32.const 2))))
  (global.set $pmode (i32.const 3))
  (global.set $dseed (local.get $n))
  (if (local.get $own)
    (then ;; mown lawn checker
      (local.set $k (i32.and (i32.add (local.get $i) (i32.shr_u (local.get $i) (i32.const 3))) (i32.const 1)))
      (local.set $c (call $pi (i32.add (local.get $row) (i32.sub (i32.const 3) (local.get $k)))))
      (global.set $c2 (call $pi (i32.add (local.get $row) (i32.add (i32.const 2) (local.get $k)))))
      (global.set $dlev (i32.const 2)))
    (else ;; rough wild grass, per-tile tone from the seed (one tone under frost)
      (local.set $k (i32.and (i32.and (local.get $n) (i32.const 1)) (i32.ne (global.get $sc_wx) (i32.const 4))))
      (local.set $c (call $pi (i32.add (local.get $row) (local.get $k))))
      (global.set $c2 (call $pi (i32.add (local.get $row) (i32.sub (i32.const 1) (local.get $k)))))
      (global.set $dlev (i32.add (i32.const 3) (i32.and (i32.shr_u (local.get $n) (i32.const 4)) (i32.const 3))))
      (if (i32.eq (global.get $sc_wx) (i32.const 4)) (then (global.set $dlev (i32.const 2))))))   ;; frost: sparse rime
  (call $iso_quad (local.get $wx) (local.get $wy) (i32.const 0) (i32.const 16) (i32.const 16) (local.get $c))
  (local.set $glow (i32.or (i32.eq (local.get $i) (global.get $sel_tile)) (i32.eq (local.get $i) (global.get $hover_tile))))
  (if (local.get $bed) (then
    ;; tilled bed inset one unit, three furrow ridges (lit crest + shaded trough)
    (local.set $k (select (global.get $H_SOIL) (global.get $H_TILLED) (i32.eq (global.get $sc_wx) (i32.const 2))))
    (global.set $c2 (call $hc (local.get $k) (i32.const 1)))
    (global.set $dlev (i32.const 6))
    (call $iso_quad (i32.add (local.get $wx) (i32.const 1)) (i32.add (local.get $wy) (i32.const 1)) (i32.const 0) (i32.const 14) (i32.const 14)
      (call $hc (local.get $k) (i32.const 2)))
    (global.set $pmode (i32.const 0))
    (local.set $lt (call $hc (local.get $k) (i32.const 3)))
    (if (i32.eq (global.get $sc_sea) (i32.const 3)) (then (local.set $lt (call $hc (global.get $H_PAPER) (i32.const 3)))))
    (if (i32.eq (global.get $sc_wx) (i32.const 4)) (then (local.set $lt (call $hc (global.get $H_STONE) (i32.const 2)))))
    (local.set $dk (call $hc (local.get $k) (i32.const 0)))
    (local.set $q (i32.const 3))
    (loop $r
      (call $iso_quad (i32.add (local.get $wx) (i32.const 1)) (i32.add (local.get $wy) (local.get $q)) (i32.const 0) (i32.const 14) (i32.const 1) (local.get $lt))
      (call $iso_quad (i32.add (local.get $wx) (i32.const 1)) (i32.add (i32.add (local.get $wy) (local.get $q)) (i32.const 1)) (i32.const 0) (i32.const 14) (i32.const 1) (local.get $dk))
      (br_if $r (i32.lt_u (local.tee $q (i32.add (local.get $q) (i32.const 4))) (i32.const 14))))
    (if (i32.eq (global.get $sc_wx) (i32.const 2)) (then
      ;; drought: two cracks
      (call $pline (call $iso_pk (i32.add (local.get $wx) (i32.const 3)) (i32.add (local.get $wy) (i32.const 5)) (i32.const 0))
                   (call $iso_pk (i32.add (local.get $wx) (i32.const 9)) (i32.add (local.get $wy) (i32.const 8)) (i32.const 0)) (local.get $dk))
      (call $pline (call $iso_pk (i32.add (local.get $wx) (i32.const 9)) (i32.add (local.get $wy) (i32.const 8)) (i32.const 0))
                   (call $iso_pk (i32.add (local.get $wx) (i32.const 12)) (i32.add (local.get $wy) (i32.const 13)) (i32.const 0)) (local.get $dk))))))
  (global.set $pmode (i32.const 1))
  (if (local.get $glow) (then (call $iso_quad (local.get $wx) (local.get $wy) (i32.const 0) (i32.const 16) (i32.const 16)
    (call $hc (select (global.get $H_WHEAT) (global.get $H_PAPER) (i32.eq (local.get $i) (global.get $sel_tile))) (i32.const 3)))))
  (global.set $pmode (i32.const 0))
  (if (i32.eqz (local.get $bed)) (then
    ;; tufts (wild), flowers in spring
    (local.set $dk (call $hc (select (global.get $H_GRASS2) (global.get $H_GRASS) (i32.ge_u (call $grow_row) (i32.const 2))) (i32.const 0)))
    (local.set $k (i32.const 0))
    (loop $t
      (local.set $q (call $noise (i32.add (i32.shl (local.get $i) (i32.const 3)) (local.get $k)) (i32.xor (global.get $sc_seed) (i32.const 0x55))))
      (call $iso_proj (i32.add (local.get $wx) (i32.add (i32.const 1) (call $mod (local.get $q) (i32.const 14))))
                      (i32.add (local.get $wy) (i32.add (i32.const 1) (call $mod (i32.shr_u (local.get $q) (i32.const 8)) (i32.const 14)))) (i32.const 0))
      (if (i32.and (i32.eqz (global.get $sc_sea)) (i32.lt_u (local.get $k) (i32.const 2)))
        (then
          (local.set $c (call $hc (select (global.get $H_PAPER) (select (global.get $H_APPLE) (global.get $H_CORN) (i32.and (local.get $q) (i32.const 0x10000)))
            (i32.and (local.get $q) (i32.const 0x20000))) (i32.const 3)))
          (call $px (global.get $sx) (global.get $sy) (local.get $c))
          (call $px (i32.add (global.get $sx) (i32.const 1)) (global.get $sy) (local.get $c)))
        (else (if (i32.eqz (local.get $own)) (then
          (call $px (global.get $sx) (global.get $sy) (local.get $dk))
          (call $px (global.get $sx) (i32.sub (global.get $sy) (i32.const 1)) (local.get $dk))
          (call $px (i32.add (global.get $sx) (i32.const 1)) (i32.sub (global.get $sy) (i32.const 2)) (local.get $dk))))))
      (br_if $t (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1))) (i32.const 4)))))))

;; Fence piece: post at (x, y) and two rails running 16 units along x (dir 0) or y (dir 1).
(func $fence (param $x i32) (param $y i32) (param $dir i32) (param $rails i32)
  (local $z i32)
  (call $iso_box (local.get $x) (local.get $y) (i32.const 0) (i32.const 1) (i32.const 1) (i32.const 6) (global.get $H_WOOD))
  (if (i32.eqz (local.get $rails)) (then (return)))
  (global.set $outline (i32.const 0))
  (local.set $z (i32.const 2))
  (loop $l
    (call $iso_box (i32.add (local.get $x) (i32.eqz (local.get $dir))) (i32.add (local.get $y) (local.get $dir)) (local.get $z)
      (select (i32.const 1) (i32.const 15) (local.get $dir)) (select (i32.const 15) (i32.const 1) (local.get $dir)) (i32.const 1) (global.get $H_WOOD))
    (br_if $l (i32.lt_u (local.tee $z (i32.add (local.get $z) (i32.const 2))) (i32.const 5))))
  (global.set $outline (i32.const 1)))

;; Shadow (pass 0) or object (pass 1) layer, back to front by diagonal; fences, sale sign.
(func $objects (param $pass i32)
  (local $s i32) (local $tx i32) (local $ty i32) (local $i i32) (local $m i32) (local $g i32) (local $in i32)
  (local.set $g (global.get $sc_g))
  (loop $ls
    (local.set $tx (i32.const 0))
    (loop $lt
      (local.set $ty (i32.sub (local.get $s) (local.get $tx)))
      (if (i32.lt_u (local.get $ty) (i32.const 8)) (then
        (local.set $i (i32.add (i32.shl (local.get $ty) (i32.const 3)) (local.get $tx)))
        (local.set $in (i32.and (i32.lt_u (local.get $tx) (local.get $g)) (i32.lt_u (local.get $ty) (local.get $g))))
        (if (i32.and (local.get $pass) (local.get $in)) (then
          (if (i32.eqz (local.get $tx)) (then (call $fence (i32.const 0) (i32.shl (local.get $ty) (i32.const 4)) (i32.const 1) (i32.const 1))))
          (if (i32.eqz (local.get $ty)) (then (call $fence (i32.shl (local.get $tx) (i32.const 4)) (i32.const 0) (i32.const 0)
            (i32.ne (local.get $tx) (i32.sub (local.get $g) (i32.const 1))))))))
        (local.set $m (call $tile_model (local.get $i)))
        (if (i32.ge_s (local.get $m) (i32.const 0)) (then
          (call $model (local.get $m) (i32.shl (local.get $tx) (i32.const 4)) (i32.shl (local.get $ty) (i32.const 4)) (local.get $pass))))
        (global.set $rot (i32.const 0))
        (if (i32.and (local.get $pass) (local.get $in)) (then
          (if (i32.eq (local.get $tx) (i32.sub (local.get $g) (i32.const 1)))
            (then (call $fence (i32.shl (local.get $g) (i32.const 4)) (i32.shl (local.get $ty) (i32.const 4)) (i32.const 1) (i32.const 1))))
          (if (i32.eq (local.get $ty) (i32.sub (local.get $g) (i32.const 1))) (then
            (call $fence (i32.shl (local.get $tx) (i32.const 4)) (i32.shl (local.get $g) (i32.const 4)) (i32.const 0) (i32.const 1))
            (if (i32.eq (local.get $tx) (i32.sub (local.get $g) (i32.const 1)))
              (then (call $fence (i32.shl (local.get $g) (i32.const 4)) (i32.shl (local.get $g) (i32.const 4)) (i32.const 0) (i32.const 0))))))))
        ;; "for sale" sign on the wild tile beyond the owned corner
        (if (i32.and (i32.lt_u (local.get $g) (i32.const 8))
                     (i32.and (i32.eq (local.get $tx) (local.get $g)) (i32.eq (local.get $ty) (local.get $g)))) (then
          (call $mc (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0))
          (call $model (i32.const 27) (i32.shl (local.get $tx) (i32.const 4)) (i32.shl (local.get $ty) (i32.const 4)) (local.get $pass))))))
      (br_if $lt (i32.lt_u (local.tee $tx (i32.add (local.get $tx) (i32.const 1))) (i32.const 8))))
    (br_if $ls (i32.lt_u (local.tee $s (i32.add (local.get $s) (i32.const 1))) (i32.const 15)))))

;; ---------------------------------------------------------------- weather particles

(func $particles (param $L i32)
  (local $i i32) (local $n i32) (local $x i32) (local $y i32) (local $q i32) (local $c i32) (local $t i32)
  (local $w i32) (local $h i32) (local $ph i32) (local $rw i32) (local $p i32)
  (if (global.get $flag_reduced) (then (return)))
  (local.set $w (global.get $fb_w)) (local.set $h (global.get $fb_h))
  (local.set $t (call $mod (global.get $sc_t) (i32.const 60000)))
  (local.set $rw (global.get $sc_wx))
  ;; rain / storm streaks
  (if (i32.or (i32.eq (local.get $rw) (i32.const 1)) (i32.eq (local.get $rw) (i32.const 3))) (then
    (local.set $n (i32.div_u (i32.mul (local.get $w) (local.get $h)) (select (i32.const 650) (i32.const 1100) (i32.eq (local.get $rw) (i32.const 3)))))
    (local.set $c (call $hc (global.get $H_SKY) (i32.const 3)))
    (block $rd (loop $rl
      (br_if $rd (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $q (call $noise (local.get $i) (i32.const 91)))
      (local.set $y (i32.sub (call $mod (i32.add (call $mod (i32.shr_u (local.get $q) (i32.const 8)) (i32.add (local.get $h) (i32.const 16)))
        (i32.div_u (i32.mul (local.get $t) (i32.add (i32.const 420) (i32.shl (i32.and (local.get $i) (i32.const 3)) (i32.const 6)))) (i32.const 1000)))
        (i32.add (local.get $h) (i32.const 16))) (i32.const 8)))
      (local.set $x (i32.sub (call $mod (local.get $q) (i32.add (local.get $w) (i32.const 64))) (i32.shr_s (local.get $y) (i32.const 2))))
      (call $line (local.get $x) (local.get $y) (i32.sub (local.get $x) (i32.const 2)) (i32.add (local.get $y) (i32.add (i32.const 6) (i32.and (local.get $i) (i32.const 3)))) (local.get $c))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $rl)))))
  ;; storm: lightning bolt on flash frames
  (if (i32.and (i32.eq (local.get $rw) (i32.const 3)) (call $flash)) (then
    (local.set $q (i32.div_u (global.get $sc_t) (i32.const 3690)))
    (local.set $x (call $mod (call $noise (local.get $q) (i32.const 5)) (local.get $w)))
    (local.set $y (i32.const 0))
    (local.set $c (call $hc (global.get $H_PAPER) (i32.const 3)))
    (local.set $i (i32.const 0))
    (loop $bl
      (local.set $p (i32.sub (i32.add (local.get $x) (call $mod (call $noise (local.get $q) (i32.add (local.get $i) (i32.const 40))) (i32.const 17))) (i32.const 8)))
      (local.set $ph (i32.add (local.get $y) (i32.div_u (global.get $sc_hz) (i32.const 5))))
      (call $line (local.get $x) (local.get $y) (local.get $p) (local.get $ph) (local.get $c))
      (call $line (i32.add (local.get $x) (i32.const 1)) (local.get $y) (i32.add (local.get $p) (i32.const 1)) (local.get $ph) (local.get $c))
      (local.set $x (local.get $p)) (local.set $y (local.get $ph))
      (br_if $bl (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (i32.const 6))))))
  ;; frost: twinkling sparkles over the land
  (if (i32.eq (local.get $rw) (i32.const 4)) (then
    (local.set $n (i32.div_u (i32.mul (local.get $w) (local.get $h)) (i32.const 1800)))
    (local.set $c (call $hc (global.get $H_PAPER) (i32.const 3)))
    (local.set $i (i32.const 0))
    (block $fd (loop $fl
      (br_if $fd (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $q (call $noise (local.get $i) (i32.const 93)))
      (local.set $ph (i32.and (i32.add (i32.div_u (global.get $sc_t) (i32.const 130)) (i32.shr_u (local.get $q) (i32.const 24))) (i32.const 7)))
      (if (i32.lt_u (local.get $ph) (i32.const 2)) (then
        (local.set $x (call $mod (local.get $q) (local.get $w)))
        (local.set $y (i32.add (global.get $sc_hz) (call $mod (i32.shr_u (local.get $q) (i32.const 10)) (i32.add (i32.sub (local.get $h) (global.get $sc_hz)) (i32.const 1)))))
        (call $px (local.get $x) (local.get $y) (local.get $c))
        (if (i32.eqz (local.get $ph)) (then
          (call $px (i32.sub (local.get $x) (i32.const 1)) (local.get $y) (local.get $c)) (call $px (i32.add (local.get $x) (i32.const 1)) (local.get $y) (local.get $c))
          (call $px (local.get $x) (i32.sub (local.get $y) (i32.const 1)) (local.get $c)) (call $px (local.get $x) (i32.add (local.get $y) (i32.const 1)) (local.get $c))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $fl)))))
  ;; heatwave: shimmer rows around the horizon
  (if (i32.eq (local.get $rw) (i32.const 5)) (then
    (local.set $y (call $clamp (i32.sub (global.get $sc_hz) (i32.shr_u (global.get $sc_hz) (i32.const 2))) (i32.const 0) (local.get $h)))
    (local.set $n (call $clamp (i32.add (global.get $sc_hz) (global.get $iso_hw)) (i32.const 0) (local.get $h)))
    (block $hd (loop $hl
      (br_if $hd (i32.ge_s (local.get $y) (local.get $n)))
      (local.set $ph (i32.and (i32.add (i32.shr_u (local.get $y) (i32.const 1)) (i32.div_u (local.get $t) (i32.const 90))) (i32.const 3)))
      (local.set $p (i32.add (global.get $R_FB) (i32.shl (i32.mul (local.get $y) (local.get $w)) (i32.const 2))))
      (if (i32.eq (local.get $ph) (i32.const 1)) (then (memory.copy (i32.add (local.get $p) (i32.const 4)) (local.get $p) (i32.shl (i32.sub (local.get $w) (i32.const 1)) (i32.const 2)))))
      (if (i32.eq (local.get $ph) (i32.const 3)) (then (memory.copy (local.get $p) (i32.add (local.get $p) (i32.const 4)) (i32.shl (i32.sub (local.get $w) (i32.const 1)) (i32.const 2)))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br $hl)))
    ;; wavy pale streaks rising off the soil, two per owned tile
    (global.set $pmode (i32.const 1))
    (local.set $i (i32.const 0))
    (loop $wl
      (if (call $in_grid (i32.shr_u (local.get $i) (i32.const 1))) (then
        (local.set $q (call $noise (local.get $i) (i32.const 77)))
        (call $iso_proj (i32.add (i32.shl (i32.and (i32.shr_u (local.get $i) (i32.const 1)) (i32.const 7)) (i32.const 4)) (i32.add (i32.const 3) (call $mod (local.get $q) (i32.const 10))))
                        (i32.add (i32.shl (i32.shr_u (local.get $i) (i32.const 4)) (i32.const 4)) (i32.add (i32.const 3) (call $mod (i32.shr_u (local.get $q) (i32.const 8)) (i32.const 10))))
                        (i32.const 3))
        (local.set $ph (i32.add (i32.shr_u (local.get $q) (i32.const 16)) (i32.div_u (local.get $t) (i32.const 70))))
        (local.set $n (i32.const 0))
        (loop $sq
          (local.set $x (i32.add (global.get $sx) (i32.shr_s (call $sin (i32.add (local.get $ph) (local.get $n))) (i32.const 5))))
          (call $span (local.get $x) (i32.add (local.get $x) (i32.const 1)) (i32.sub (global.get $sy) (local.get $n)) (call $hc (global.get $H_PAPER) (i32.const 3)))
          (br_if $sq (i32.lt_u (local.tee $n (i32.add (local.get $n) (i32.const 1))) (i32.shr_u (global.get $iso_hw) (i32.const 2)))))))
      (br_if $wl (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (i32.const 128))))
    (global.set $pmode (i32.const 0))))
  ;; drought dust, autumn leaves, winter snow: drifting motes
  (local.set $c (i32.const -1))
  (if (i32.eq (local.get $rw) (i32.const 2)) (then (local.set $c (i32.const 0)) (local.set $n (i32.const 2600))))
  (if (i32.eqz (local.get $rw)) (then
    (if (i32.eq (global.get $sc_sea) (i32.const 2)) (then (local.set $c (i32.const 1)) (local.set $n (i32.const 5000))))
    (if (i32.eq (global.get $sc_sea) (i32.const 3)) (then (local.set $c (i32.const 2)) (local.set $n (i32.const 2200))))))
  (if (i32.ge_s (local.get $c) (i32.const 0)) (then
    (local.set $n (i32.div_u (i32.mul (local.get $w) (local.get $h)) (local.get $n)))
    (local.set $i (i32.const 0))
    (block $md (loop $ml
      (br_if $md (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $q (call $noise (local.get $i) (i32.add (i32.const 97) (local.get $c))))
      (local.set $ph (i32.div_u (i32.mul (local.get $t) (i32.add (i32.const 14) (i32.and (local.get $q) (i32.const 15)))) (i32.const 1000)))
      (if (i32.eqz (local.get $c))
        (then ;; dust drifts sideways, bobbing
          (local.set $x (call $mod (i32.add (local.get $q) (i32.shl (local.get $ph) (i32.const 1))) (local.get $w)))
          (local.set $y (i32.add (call $mod (i32.shr_u (local.get $q) (i32.const 9)) (local.get $h)) (i32.and (i32.shr_u (local.get $ph) (i32.const 3)) (i32.const 1)))))
        (else ;; leaves / snow fall, swaying
          (local.set $y (call $mod (i32.add (i32.shr_u (local.get $q) (i32.const 9)) (local.get $ph)) (local.get $h)))
          (local.set $x (call $mod (i32.add (local.get $q) (i32.and (i32.shr_u (i32.add (local.get $y) (i32.shl (local.get $i) (i32.const 3))) (i32.const 4)) (i32.const 3))) (local.get $w)))))
      (local.set $p (call $hc
        (select (global.get $H_SOIL) (select (select (global.get $H_WHEAT) (global.get $H_BARN) (i32.and (local.get $i) (i32.const 1))) (global.get $H_PAPER)
          (i32.eq (local.get $c) (i32.const 1))) (i32.eqz (local.get $c)))
        (i32.const 3)))
      (call $px (local.get $x) (local.get $y) (local.get $p))
      (call $px (i32.add (local.get $x) (i32.and (i32.add (local.get $i) (i32.shr_u (local.get $ph) (i32.const 2))) (i32.const 1))) (i32.add (local.get $y) (i32.const 1)) (local.get $p))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $ml))))))

;; Storm lightning frames: 2 of every 41 slots of 90 ms (none under reduced motion).
(func $flash (result i32)
  (i32.and (i32.and (i32.eq (global.get $sc_wx) (i32.const 3)) (i32.eqz (global.get $flag_reduced)))
           (i32.lt_u (i32.rem_u (i32.div_u (global.get $sc_t) (i32.const 90)) (i32.const 41)) (i32.const 2))))

;; ---------------------------------------------------------------- overlays

;; Diamond outline of tile i (the ground glow is drawn in the ground pass). strong = the
;; selection: 2 px gold outline over a dark drop line, plus white corner brackets lifted 6
;; units with a dark shadow; hover: a 1 px cream outline.
(func $hilite (param $i i32) (param $strong i32)
  (local $wx i32) (local $wy i32) (local $a i32) (local $b i32) (local $c i32) (local $d i32) (local $col i32) (local $k i32)
  (local $z i32) (local $o i32)
  (if (i32.ge_u (local.get $i) (i32.const 64)) (then (return)))
  (local.set $wx (i32.shl (i32.and (local.get $i) (i32.const 7)) (i32.const 4)))
  (local.set $wy (i32.shl (i32.shr_u (local.get $i) (i32.const 3)) (i32.const 4)))
  (local.set $k (i32.eqz (local.get $strong)))
  (loop $l
    ;; k: 0 dark drop (+2 rows), 1 outline, 2 outline (+1 row), 3 bracket shadow (+1), 4 brackets
    (local.set $z (select (i32.const 6) (i32.const 0) (i32.ge_u (local.get $k) (i32.const 3))))
    (local.set $o (i32.load8_u (i32.add (global.get $SCD) (i32.add (i32.const 194) (local.get $k)))))
    (local.set $col (call $hc (select (global.get $H_PAPER) (global.get $H_WHEAT)
      (i32.or (i32.eq (local.get $k) (i32.const 4)) (i32.eqz (local.get $strong)))) (i32.const 3)))
    (if (i32.or (i32.eqz (local.get $k)) (i32.eq (local.get $k) (i32.const 3))) (then (local.set $col (call $hc (global.get $H_INK) (i32.const 0)))))
    (global.set $iso_oy (i32.add (global.get $iso_oy) (local.get $o)))
    (local.set $a (call $iso_pk (local.get $wx) (local.get $wy) (local.get $z)))
    (local.set $b (call $iso_pk (i32.add (local.get $wx) (i32.const 16)) (local.get $wy) (local.get $z)))
    (local.set $c (call $iso_pk (i32.add (local.get $wx) (i32.const 16)) (i32.add (local.get $wy) (i32.const 16)) (local.get $z)))
    (local.set $d (call $iso_pk (local.get $wx) (i32.add (local.get $wy) (i32.const 16)) (local.get $z)))
    (global.set $iso_oy (i32.sub (global.get $iso_oy) (local.get $o)))
    (if (i32.lt_u (local.get $k) (i32.const 3))
      (then
        (call $pline (local.get $a) (local.get $b) (local.get $col)) (call $pline (local.get $b) (local.get $c) (local.get $col))
        (call $pline (local.get $c) (local.get $d) (local.get $col)) (call $pline (local.get $d) (local.get $a) (local.get $col)))
      (else ;; corner brackets: from each corner a quarter of the way along both edges
        (call $bracket (local.get $a) (local.get $b) (local.get $d) (local.get $col))
        (call $bracket (local.get $b) (local.get $c) (local.get $a) (local.get $col))
        (call $bracket (local.get $c) (local.get $d) (local.get $b) (local.get $col))
        (call $bracket (local.get $d) (local.get $a) (local.get $c) (local.get $col))))
    (br_if $l (i32.and (local.get $strong) (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1))) (i32.const 5))))))

(func $bracket (param $p i32) (param $a i32) (param $b i32) (param $c i32)
  (local $x i32) (local $y i32)
  (local.set $x (i32.extend16_s (local.get $p)))
  (local.set $y (i32.shr_s (local.get $p) (i32.const 16)))
  (call $line (local.get $x) (local.get $y)
    (i32.add (local.get $x) (i32.shr_s (i32.sub (i32.extend16_s (local.get $a)) (local.get $x)) (i32.const 2)))
    (i32.add (local.get $y) (i32.shr_s (i32.sub (i32.shr_s (local.get $a) (i32.const 16)) (local.get $y)) (i32.const 2))) (local.get $c))
  (call $line (local.get $x) (local.get $y)
    (i32.add (local.get $x) (i32.shr_s (i32.sub (i32.extend16_s (local.get $b)) (local.get $x)) (i32.const 2)))
    (i32.add (local.get $y) (i32.shr_s (i32.sub (i32.shr_s (local.get $b) (i32.const 16)) (local.get $y)) (i32.const 2))) (local.get $c)))

;; Badge above a tile: ripe check (green) or storage-full "!" (red), scaled k = 1 or 2.
(func $badge (param $x i32) (param $y i32) (param $full i32)
  (local $k i32) (local $bw i32) (local $x0 i32) (local $y0 i32) (local $c i32) (local $j i32)
  (local.set $k (i32.add (i32.const 1) (i32.ge_u (global.get $iso_hw) (i32.const 40))))
  (local.set $bw (i32.add (i32.mul (local.get $k) (i32.const 5)) (i32.const 2)))
  (local.set $x0 (i32.sub (local.get $x) (i32.shr_u (local.get $bw) (i32.const 1))))
  (local.set $y0 (i32.sub (local.get $y) (i32.mul (local.get $k) (i32.const 6))))
  (call $rrect (i32.sub (local.get $x0) (i32.const 1)) (i32.sub (local.get $y0) (i32.const 1)) (i32.add (local.get $bw) (i32.const 2))
    (i32.add (i32.mul (local.get $k) (i32.const 6)) (i32.const 2)) (i32.const 2) (call $hc (global.get $H_INK) (i32.const 0)))
  (call $rrect (local.get $x0) (local.get $y0) (local.get $bw) (i32.mul (local.get $k) (i32.const 6)) (i32.const 2)
    (call $hc (select (global.get $H_TOMATO) (global.get $H_GRASS) (local.get $full)) (i32.const 2)))
  (call $rect (i32.sub (local.get $x) (i32.const 1)) (i32.add (local.get $y) (i32.const 1)) (i32.const 3) (i32.const 1) (call $hc (global.get $H_INK) (i32.const 0)))
  (call $px (local.get $x) (i32.add (local.get $y) (i32.const 2)) (call $hc (global.get $H_INK) (i32.const 0)))
  (local.set $c (call $hc (global.get $H_PAPER) (i32.const 3)))
  (if (local.get $full)
    (then ;; "!" from the 3x5 badge font, scaled
      (call $glyphk (i32.sub (local.get $x) (i32.add (local.get $k) (i32.shr_u (local.get $k) (i32.const 1))))
        (i32.add (local.get $y0) (local.get $k)) (i32.const 1) (local.get $c) (local.get $k)))
    (else ;; check mark
      (loop $l
        (call $line (i32.sub (local.get $x) (i32.mul (local.get $k) (i32.const 2))) (i32.add (i32.add (local.get $y0) (i32.mul (local.get $k) (i32.const 3))) (local.get $j))
                    (i32.sub (local.get $x) (local.get $k)) (i32.add (i32.add (local.get $y0) (i32.mul (local.get $k) (i32.const 4))) (local.get $j)) (local.get $c))
        (call $line (i32.sub (local.get $x) (local.get $k)) (i32.add (i32.add (local.get $y0) (i32.mul (local.get $k) (i32.const 4))) (local.get $j))
                    (i32.add (local.get $x) (i32.mul (local.get $k) (i32.const 2))) (i32.add (i32.add (local.get $y0) (local.get $k)) (local.get $j)) (local.get $c))
        (br_if $l (i32.lt_u (local.tee $j (i32.add (local.get $j) (i32.const 1))) (local.get $k)))))))

;; Badge-font glyph g scaled by k (k x k blocks).
(func $glyphk (param $x i32) (param $y i32) (param $g i32) (param $c i32) (param $k i32)
  (local $n i32)
  (loop $l
    (if (i32.and (i32.shr_u (i32.load8_u (i32.add (i32.add (global.get $FONT_BADGE) (i32.shl (local.get $g) (i32.const 1))) (i32.shr_u (local.get $n) (i32.const 3))))
                            (i32.and (local.get $n) (i32.const 7))) (i32.const 1))
      (then (call $rect (i32.add (local.get $x) (i32.mul (i32.rem_u (local.get $n) (i32.const 3)) (local.get $k)))
                        (i32.add (local.get $y) (i32.mul (i32.div_u (local.get $n) (i32.const 3)) (local.get $k)))
                        (local.get $k) (local.get $k) (local.get $c))))
    (br_if $l (i32.lt_u (local.tee $n (i32.add (local.get $n) (i32.const 1))) (i32.const 15)))))

;; Ripe crops: twinkling sparkle (motion only) and a badge; "!" when storage cannot take the
;; harvest (same units rule as $harvest_tile, with one storage count per frame). The "!" is
;; always drawn; the green check only on farms up to 6x6 with tiles big enough (hw >= 24) or on
;; the selected / hovered tile, so a crowded 7x7 / 8x8 farm is not buried in badges (Task 4
;; shows a ripe count in the UI).
;; Rotting crops get four flies buzzing over them (static under reduced motion).
(func $badges
  (local $i i32) (local $p i32) (local $c i32) (local $m i32) (local $u i32) (local $free i32) (local $k i32)
  (local $q i32) (local $wx i32) (local $wy i32) (local $ph i32) (local $col i32)
  (local.set $free (i32.sub (call $storage_cap) (call $storage_used)))
  (loop $l
    (local.set $p (call $tile_ptr (local.get $i)))
    (local.set $c (call $tile_crop (local.get $p)))
    (if (i32.and (i32.and (i32.ge_s (local.get $c) (i32.const 0)) (call $in_grid (local.get $i))) (i32.load8_u offset=4 (local.get $p))) (then
      ;; flies: four dark specks with a pale wing circling above the wilted plant
      (local.set $k (i32.const 0))
      (loop $fl
        (local.set $q (call $noise (i32.add (i32.shl (local.get $i) (i32.const 2)) (local.get $k)) (i32.const 67)))
        (local.set $ph (i32.add (i32.shr_u (local.get $q) (i32.const 12)) (i32.div_u (global.get $sc_t) (i32.const 60))))
        (call $iso_proj (i32.add (i32.shl (i32.and (local.get $i) (i32.const 7)) (i32.const 4)) (i32.add (i32.const 2) (call $mod (local.get $q) (i32.const 12))))
          (i32.add (i32.shl (i32.shr_u (local.get $i) (i32.const 3)) (i32.const 4)) (i32.add (i32.const 2) (call $mod (i32.shr_u (local.get $q) (i32.const 4)) (i32.const 12))))
          (i32.add (i32.const 5) (i32.mul (local.get $k) (i32.const 2))))
        (local.set $wx (i32.add (global.get $sx) (i32.shr_s (call $sin (local.get $ph)) (i32.const 4))))
        (local.set $wy (i32.add (global.get $sy) (i32.shr_s (call $sin (i32.add (local.get $ph) (i32.const 4))) (i32.const 5))))
        (call $rect (local.get $wx) (local.get $wy) (i32.const 2) (i32.const 1) (call $hc (global.get $H_INK) (i32.const 0)))
        (call $px (local.get $wx) (i32.sub (local.get $wy) (i32.const 1)) (call $hc (global.get $H_STONE) (i32.const 3)))
        (br_if $fl (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1))) (i32.const 4))))))
    (if (i32.and (i32.and (i32.ge_s (local.get $c) (i32.const 0)) (call $in_grid (local.get $i))) (call $tile_ripe (local.get $p))) (then
      (local.set $m (call $tile_model (local.get $i)))
      (local.set $wx (i32.add (i32.shl (i32.and (local.get $i) (i32.const 7)) (i32.const 4)) (i32.const 8)))
      (local.set $wy (i32.add (i32.shl (i32.shr_u (local.get $i) (i32.const 3)) (i32.const 4)) (i32.const 8)))
      (if (i32.eqz (global.get $flag_reduced)) (then
        (local.set $k (i32.const 0))
        (loop $s
          (local.set $q (call $noise (i32.add (i32.shl (local.get $i) (i32.const 2)) (local.get $k)) (i32.const 61)))
          (local.set $ph (i32.and (i32.add (i32.div_u (global.get $sc_t) (i32.const 110)) (i32.shr_u (local.get $q) (i32.const 26))) (i32.const 15)))
          (if (i32.lt_u (local.get $ph) (i32.const 3)) (then
            (call $iso_proj (i32.sub (i32.add (local.get $wx) (call $mod (local.get $q) (i32.const 13))) (i32.const 6))
              (i32.sub (i32.add (local.get $wy) (call $mod (i32.shr_u (local.get $q) (i32.const 8)) (i32.const 13))) (i32.const 6))
              (i32.add (i32.const 3) (call $mod (i32.shr_u (local.get $q) (i32.const 16)) (i32.add (call $mheight (local.get $m)) (i32.const 1)))))
            (local.set $col (call $hc (global.get $H_PAPER) (i32.const 3)))
            (call $px (global.get $sx) (global.get $sy) (local.get $col))
            (if (i32.eq (local.get $ph) (i32.const 1)) (then
              (local.set $col (call $hc (global.get $H_WHEAT) (i32.const 3)))
              (call $px (i32.sub (global.get $sx) (i32.const 1)) (global.get $sy) (local.get $col)) (call $px (i32.add (global.get $sx) (i32.const 1)) (global.get $sy) (local.get $col))
              (call $px (global.get $sx) (i32.sub (global.get $sy) (i32.const 1)) (local.get $col)) (call $px (global.get $sx) (i32.add (global.get $sy) (i32.const 1)) (local.get $col))))))
          (br_if $s (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1))) (i32.const 3))))))
      (local.set $u (call $bal (global.get $T_CROP) (local.get $c) (i32.const 2)))
      (if (call $event_active (global.get $EV_BUMPER))
        (then (local.set $u (i32.div_u (i32.mul (local.get $u) (call $k (global.get $K_BUMPER_BP))) (i32.const 10000)))))
      (call $iso_proj (local.get $wx) (local.get $wy) (i32.add (call $mheight (local.get $m)) (i32.const 3)))
      (if (i32.or (i32.or (i32.gt_s (local.get $u) (local.get $free))
                          (i32.and (i32.ge_u (global.get $iso_hw) (i32.const 24)) (i32.lt_u (global.get $sc_g) (i32.const 7))))
                  (i32.or (i32.eq (local.get $i) (global.get $sel_tile)) (i32.eq (local.get $i) (global.get $hover_tile))))
        (then (call $badge (global.get $sx) (global.get $sy) (i32.gt_s (local.get $u) (local.get $free)))))))
    (br_if $l (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (i32.const 64)))))

;; ---------------------------------------------------------------- entry points

(func $scene_draw
  (local $L i32) (local $i i32)
  ;; no framebuffer (before the first resize, or a failed memory.grow): nothing to draw
  (if (i32.eqz (i32.mul (global.get $fb_w) (global.get $fb_h))) (then (return)))
  (call $scene_fit)
  (global.set $sc_seed (i32.load (global.get $S_SEED)))
  (global.set $sc_sea (call $season))
  (global.set $sc_wx (call $clamp (i32.load8_u (global.get $S_WEATHER)) (i32.const 0) (i32.const 5)))
  (global.set $sc_t (select (i32.const 0) (global.get $sc_time) (global.get $flag_reduced)))
  (local.set $L (call $look))
  ;; colour grade for the look (lightning frames flash toward white)
  (global.set $tint_a (i32.const 0))
  (global.set $tint_c (call $pi (i32.add (global.get $SCD) (i32.add (i32.const 80) (i32.shl (local.get $L) (i32.const 1))))))
  (global.set $tint_a (call $tb (i32.add (i32.const 81) (i32.shl (local.get $L) (i32.const 1)))))
  (if (call $flash) (then (global.set $tint_c (call $hc (global.get $H_PAPER) (i32.const 3))) (global.set $tint_a (i32.const 5))))
  (call $backdrop (local.get $L))
  (call $props (i32.const 0))
  (global.set $cy0 (global.get $sc_hz))
  (call $road)
  (call $trucks)
  (global.set $cy0 (i32.const -0x3FFFFFFF))
  (call $props (i32.const 1))
  (call $slab)
  (loop $g
    (call $ground (local.get $i))
    (br_if $g (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (i32.const 64))))
  (call $objects (i32.const 0))
  (call $objects (i32.const 1))
  (call $props_front)
  (call $particles (local.get $L))
  (call $hilite (global.get $hover_tile) (i32.const 0))
  (call $hilite (global.get $sel_tile) (i32.const 1))
  (call $badges)
  (global.set $tint_a (i32.const 0))
  (global.set $outline (i32.const 1))
  (global.set $pmode (i32.const 0)))

;; Ground-diamond bounding box of tile i -> $tr_x/$tr_y/$tr_w/$tr_h.
(func $tile_rect (param $i i32)
  (local $wx i32) (local $wy i32)
  (call $scene_fit)
  (local.set $wx (i32.shl (i32.and (local.get $i) (i32.const 7)) (i32.const 4)))
  (local.set $wy (i32.shl (i32.and (i32.shr_u (local.get $i) (i32.const 3)) (i32.const 7)) (i32.const 4)))
  (call $iso_proj (local.get $wx) (local.get $wy) (i32.const 0))
  (global.set $tr_y (global.get $sy))
  (call $iso_proj (local.get $wx) (i32.add (local.get $wy) (i32.const 16)) (i32.const 0))
  (global.set $tr_x (global.get $sx))
  (call $iso_proj (i32.add (local.get $wx) (i32.const 16)) (i32.add (local.get $wy) (i32.const 16)) (i32.const 0))
  (global.set $tr_h (i32.sub (global.get $sy) (global.get $tr_y)))
  (call $iso_proj (i32.add (local.get $wx) (i32.const 16)) (local.get $wy) (i32.const 0))
  (global.set $tr_w (i32.sub (global.get $sx) (global.get $tr_x))))

;; Screen point -> slab tile index 0..63 (owned or not; the UI offers unowned land) or -1
;; (sky, meadow, off the framebuffer). Three steps:
;;  1. ground tile g under the pixel centre (inverse projection). If the point lies in the
;;     core of g's diamond (the inner 5/8 of each diagonal = 39% of its area, incl. the
;;     centre) the answer is g: every plot stays tappable even behind tall models.
;;  2. otherwise tall model bodies (>= 6 units), front to back: a box of +-5/8 hw around the
;;     tile centre from the model top down to the model's own diamond top vertex, so a tree
;;     crown or a roof that overhangs the ring of the tiles behind selects its own tile;
;;  3. else g (or -1 off the slab).
(func $tile_at (param $px i32) (param $py i32) (result i32)
  (local $s i32) (local $tx i32) (local $ty i32) (local $i i32) (local $m i32) (local $h i32) (local $cx i32) (local $cy i32)
  (local $u i32) (local $v i32) (local $d i32) (local $g i32)
  (call $scene_fit)
  (if (i32.or (i32.ge_u (local.get $px) (global.get $fb_w)) (i32.ge_u (local.get $py) (global.get $fb_h))) (then (return (i32.const -1))))
  ;; ground: invert the projection at the pixel centre; wx = (16 dx + 32 dy) / (4 hw)
  (local.set $cx (i32.add (i32.shl (i32.sub (local.get $px) (global.get $iso_ox)) (i32.const 1)) (i32.const 1)))
  (local.set $cy (i32.add (i32.shl (i32.sub (local.get $py) (global.get $iso_oy)) (i32.const 1)) (i32.const 1)))
  (local.set $u (i32.add (i32.shl (local.get $cx) (i32.const 4)) (i32.shl (local.get $cy) (i32.const 5))))
  (local.set $v (i32.sub (i32.shl (local.get $cy) (i32.const 5)) (i32.shl (local.get $cx) (i32.const 4))))
  (local.set $d (i32.shl (global.get $iso_hw) (i32.const 6)))   ;; 4 hw * 16 units per tile
  (local.set $g (i32.const -1))
  (if (i32.and (i32.ge_s (local.get $u) (i32.const 0)) (i32.ge_s (local.get $v) (i32.const 0))) (then
    (local.set $tx (i32.div_s (local.get $u) (local.get $d)))
    (local.set $ty (i32.div_s (local.get $v) (local.get $d)))
    (if (i32.and (i32.lt_u (local.get $tx) (i32.const 8)) (i32.lt_u (local.get $ty) (i32.const 8))) (then
      (local.set $g (i32.add (i32.shl (local.get $ty) (i32.const 3)) (local.get $tx)))
      ;; core: |2 (u mod d) - d| <= 5/8 d on both diagonals
      (if (i32.and (call $core (i32.sub (local.get $u) (i32.mul (local.get $tx) (local.get $d))) (local.get $d))
                   (call $core (i32.sub (local.get $v) (i32.mul (local.get $ty) (local.get $d))) (local.get $d)))
        (then (return (local.get $g))))))))
  (local.set $s (i32.const 14))
  (loop $ls
    (local.set $tx (i32.const 7))
    (loop $lt
      (local.set $ty (i32.sub (local.get $s) (local.get $tx)))
      (if (i32.lt_u (local.get $ty) (i32.const 8)) (then
        (local.set $i (i32.add (i32.shl (local.get $ty) (i32.const 3)) (local.get $tx)))
        (local.set $m (call $tile_model (local.get $i)))
        (if (i32.ge_s (local.get $m) (i32.const 0)) (then
          (local.set $h (call $mheight (local.get $m)))
          (if (i32.ge_u (local.get $h) (i32.const 6)) (then
            ;; body box: rows from the back corner at the model's top height (less 1 px of
            ;; outline) down to the tile's own top vertex; columns cx +- 5/8 hw
            (call $iso_proj (i32.shl (local.get $tx) (i32.const 4)) (i32.shl (local.get $ty) (i32.const 4)) (local.get $h))
            (local.set $cx (global.get $sx)) (local.set $cy (i32.sub (global.get $sy) (i32.const 1)))
            (call $iso_proj (i32.shl (local.get $tx) (i32.const 4)) (i32.shl (local.get $ty) (i32.const 4)) (i32.const 0))
            (if (i32.and (i32.le_u (i32.add (i32.sub (local.get $px) (local.get $cx)) (i32.shr_u (i32.mul (global.get $iso_hw) (i32.const 5)) (i32.const 3)))
                                   (i32.shr_u (i32.mul (global.get $iso_hw) (i32.const 5)) (i32.const 2)))
                         (i32.and (i32.ge_s (local.get $py) (local.get $cy)) (i32.lt_s (local.get $py) (global.get $sy))))
              (then (return (local.get $i))))))))))
      (br_if $lt (i32.ge_s (local.tee $tx (i32.sub (local.get $tx) (i32.const 1))) (i32.const 0))))
    (br_if $ls (i32.ge_s (local.tee $s (i32.sub (local.get $s) (i32.const 1))) (i32.const 0))))
  (local.get $g))

(func $core (param $f i32) (param $d i32) (result i32)
  (local.set $f (i32.sub (i32.shl (local.get $f) (i32.const 1)) (local.get $d)))
  (i32.le_u (i32.shl (select (local.get $f) (i32.sub (i32.const 0) (local.get $f)) (i32.ge_s (local.get $f) (i32.const 0))) (i32.const 3))
            (i32.mul (local.get $d) (i32.const 5))))

;; Test hooks.
(func $t_scene_flags (param $reduced i32) (param $sel i32) (param $hover i32)
  (global.set $flag_reduced (local.get $reduced)) (global.set $sel_tile (local.get $sel)) (global.set $hover_tile (local.get $hover)))
(func $t_tile_rect (param $i i32) (param $k i32) (result i32)
  (call $tile_rect (local.get $i))
  (select (select (global.get $tr_x) (global.get $tr_y) (i32.eqz (local.get $k)))
          (select (global.get $tr_w) (global.get $tr_h) (i32.eq (local.get $k) (i32.const 2)))
          (i32.lt_u (local.get $k) (i32.const 2))))
